{
  "name": "kalabhairava1000names",
  "version": "1.0.0",
  "description": "A fast, framework-free devotional web app presenting the 1000 names of Sri Kalabhairava with English meanings, search, and mobile-friendly reading.",
  "scripts": {
    "start": "node scripts/run-python.js simple-server.py",
    "start:fast": "node dev-server.js --open",
    "start:serve": "serve . --no-clipboard --no-request-logging -l 8000",
    "playwright:install": "playwright install chromium",
    "prepare": "husky",
    "test": "node scripts/run-python.js -m pytest tests/",
    "test:repo": "node scripts/run-python.js -m pytest tests/",
    "test:e2e": "playwright test tests/e2e/site-smoke.spec.js",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.js",
    "test:perf": "playwright test tests/e2e/perf-budget.spec.js",
    "validate": "npm run test:repo && npm run test:e2e && npm run test:visual && npm run test:perf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/09ashishkapoor/kalabhairava1000names.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/09ashishkapoor/kalabhairava1000names/issues"
  },
  "homepage": "https://github.com/09ashishkapoor/kalabhairava1000names#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "serve": "^14.2.6"
  }
}
