---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';

import { getStaticNamesData } from '../../lib/staticNames.js';

const { hub, totalCount, ranges } = getStaticNamesData();

const hubSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${hub.canonical}#webpage`,
      name: 'Kalabhairava Names Hub',
      description: hub.description,
      url: hub.canonical,
      inLanguage: 'en',
      isPartOf: {
        '@id': 'https://bhairavakalikenamosthute.com/#website'
      },
      hasPart: ranges.map((range) => ({
        '@type': 'CollectionPage',
        name: range.heading,
        url: range.canonical
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${hub.canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://bhairavakalikenamosthute.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Names Hub',
          item: hub.canonical
        }
      ]
    }
  ]
};
---

<ReferenceLayout
	title={hub.title}
	description={hub.description}
	canonical={hub.canonical}
	schema={hubSchema}
>
<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li><span aria-current="page">Names hub</span></li>
				</ol>
			</nav>
<p class="page-kicker">Static study hub</p>
      <h1>Kalabhairava Names Hub</h1>

      <figure class="page-figure">
        <img
          src="/kalabhairava-bg-desktop.webp"
          alt="Statue of Kalabhairava with a trident, skull garland, and red hibiscus flowers"
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Kalabhairava — devotional image used on this site.</figcaption>
      </figure>

      <section class="hero-panel">
        <p class="intro">Use this static hub to browse all <strong>{totalCount}</strong> Kalabhairava names by range. Each section page lists its entries with one-line and detailed English meanings, and every name links to its own reference page with Devanagari, transliteration, alternate spellings, and meaning.</p>
        <nav class="page-nav" aria-label="Hub navigation">
          <ul>
            <li><a href="/">Open the interactive homepage reader</a></li>
            <li><a href="/kalabhairava-sahasranama-pdf/">Download the free PDF editions</a></li>
            <li><a href="/sources/">Read sources and editorial notes</a></li>
            <li><a href="/108-names-of-kalabhairava/">108 names of Kalabhairava</a></li>
            <li><a href="/1000-names-of-kalabhairava/">1,008 vs 1,000 names</a></li>
            <li><a href="/kalabhairava-sahasranama-lyrics/">Kalabhairava Sahasranama lyrics</a></li>
            <li><a href="/kalabhairava-sahasranama-benefits/">Kalabhairava Sahasranama benefits</a></li>
          </ul>
        </nav>
      </section>

      <section class="ranges-panel" aria-labelledby="ranges-heading">
        <div class="section-heading">
          <p class="section-kicker">Directory</p>
          <h2 id="ranges-heading">Browse by name ranges</h2>
        </div>
        <ol class="range-list">
          {ranges.map((range) => (
            <li>
              <a href={range.path}>{range.heading}</a>
              <div>Starts with {range.firstName.english} and ends with {range.lastName.english}.</div>
            </li>
          ))}
        </ol>
      </section>

      <section class="source-notes" aria-labelledby="hub-source-notes-heading">
        <h2 id="hub-source-notes-heading">Sources and notes</h2>
        <p>This project compiles devotional source material and explanatory meaning notes for spiritual study and chanting support.</p>
        <p>Primary public references used during compilation include:</p>
        <ul>
          <li><a href="https://sanskritdocuments.org/" rel="noopener noreferrer">SanskritDocuments.org</a></li>
        </ul>
        <p>If you notice an inaccuracy, please review the open-source repository or contact the maintainer through the links on the homepage.</p>
      </section>
</ReferenceLayout>
