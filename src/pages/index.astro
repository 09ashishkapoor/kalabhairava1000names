---
import PothiLayout from "../layouts/PothiLayout.astro";
import { getStaticNamesData } from "../lib/staticNames.js";
import { folio, parseElaboration } from "../lib/pothi.js";

const {
	entries,
	sets,
	totalSets,
	totalCount,
	ranges,
	pothiIndex,
	chunkSize,
	chunkCount,
} = getStaticNamesData();

const firstSet = sets[0];
const first = firstSet.entries[0];
const firstBlocks = parseElaboration(first.english_elaboration);
const canonical = "https://bhairavakalikenamosthute.com/";
const title =
	"1000 Names of Kalabhairava (Kalabhairava Sahasranama) with Meanings | Kalabhairava 1000 Names";
const description =
	"Read all 1,000 names of Kalabhairava with English meanings, Devanagari, and a free PDF — a searchable Kalabhairava Sahasranama index.";

function searchText(entry) {
	return `${entry.devanagari} ${entry.iast} ${entry.spelling_common} ${entry.spelling_site} ${entry.english_one_line}`
		.normalize("NFD")
		.replace(/\p{M}/gu, "")
		.toLowerCase();
}

// The compact index is the reader's whole-book data: Devanagari + IAST
// (which the runtime chunks do not carry), the one-line meaning and the slug.
// The elaboration stays in /data_chunk_*.json and is fetched per set.
const indexJson = JSON.stringify(pothiIndex).replace(/</g, "\\u003c");
const bootJson = JSON.stringify({
	entries: firstSet.entries.map((entry) => ({
		n: entry.index,
		d: entry.devanagari,
		i: entry.iast,
		c: entry.spelling_common,
		src: entry.spelling_site,
		m: entry.english_one_line,
		slug: entry.page_slug,
		e: entry.english_elaboration,
	})),
	total: totalCount,
	totalSets,
	chunkSize,
	chunkCount,
}).replace(/</g, "\\u003c");

const homeSchemas = [
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"@id": "https://bhairavakalikenamosthute.com/#webpage",
		name: "Kalabhairava 1000 Names - Complete Sahasranama",
		alternateName: "Kālābhairava Sahasrānāma",
		description:
			"Complete Kalabhairava 1000 Names (Sahasranama) with detailed meanings in English. Discover all 1000+ sacred names of Kalabhairava with translations, elaborations, and devotional context. Searchable and reference-ready for chanting, study, or spiritual practice.",
		url: "https://bhairavakalikenamosthute.com/",
		hasPart: {
			"@type": "CollectionPage",
			"@id": "https://bhairavakalikenamosthute.com/names/#webpage",
			name: "Kalabhairava Names Reference Hub",
			url: "https://bhairavakalikenamosthute.com/names/",
		},
		inLanguage: "en",
		isAccessibleForFree: true,
		about: {
			"@type": "Thing",
			name: "Kalabhairava Sahasranama",
			description: "The 1000 names of Lord Kalabhairava",
		},
		mainEntity: {
			"@type": "CollectionPage",
			"@id": "https://bhairavakalikenamosthute.com/#collection",
			name: "Kalabhairava 1000 Names Collection",
			description: "Complete collection of 1000+ names of Kalabhairava with meanings",
		},
		publisher: {
			"@type": "Person",
			"@id": "https://bhairavakalikenamosthute.com/#publisher",
			name: "Kaliputra Ashish",
			url: "https://bhairavakalikenamosthute.com/",
			sameAs: [
				"https://github.com/09ashishkapoor",
				"https://www.instagram.com/ashishkaliputra",
			],
		},
		image: {
			"@type": "ImageObject",
			url: "https://bhairavakalikenamosthute.com/kalabhairava-bg-desktop.webp",
			width: 1200,
			height: 630,
			caption: "Kalabhairava — devotional artwork",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": "https://bhairavakalikenamosthute.com/#website",
		name: "Kalabhairava 1000 Names",
		alternateName: "Kālābhairava Sahasrānāma",
		url: "https://bhairavakalikenamosthute.com/",
		inLanguage: "en",
		description: "Complete Kalabhairava 1000 Names (Sahasranama) with detailed meanings in English",
		potentialAction: {
			"@type": "SearchAction",
			target: {
				"@type": "EntryPoint",
				urlTemplate: "https://bhairavakalikenamosthute.com/?q={search_term_string}",
			},
			"query-input": {
				"@type": "PropertyValueSpecification",
				valueRequired: true,
				valueName: "search_term_string",
			},
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"@id": "https://bhairavakalikenamosthute.com/#collection",
		name: "Kalabhairava 1000 Names Collection",
		description:
			"Complete collection of 1000+ sacred names of Kalabhairava with English translations and elaborations",
		url: "https://bhairavakalikenamosthute.com/",
		isPartOf: { "@id": "https://bhairavakalikenamosthute.com/#website" },
		mainEntity: {
			"@type": "ItemList",
			name: "Kalabhairava Sahasranama Names",
			description: "List of 1000+ names of Kalabhairava",
			numberOfItems: 1000,
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"@id": "https://bhairavakalikenamosthute.com/#faq",
		isPartOf: { "@id": "https://bhairavakalikenamosthute.com/#webpage" },
		mainEntity: [
			{
				"@type": "Question",
				name: "What is Kalabhairava 1000 Names?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "Kalabhairava 1000 Names, also called Kalabhairava Sahasranama, is a devotional collection of sacred names of Lord Kalabhairava with English meanings for chanting, study, and spiritual reflection.",
				},
			},
			{
				"@type": "Question",
				name: "How many names are in Kalabhairava Sahasranama?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "This site presents 1,000 names of Kalabhairava. Each entry includes a one-line English meaning and a longer explanatory note.",
				},
			},
			{
				"@type": "Question",
				name: "Where can I find Kalabhairava 1000 names with meanings?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "You can read the interactive homepage reader or use the static names reference hub at https://bhairavakalikenamosthute.com/names/, which links to crawlable range pages for the full collection.",
				},
			},
			{
				"@type": "Question",
				name: "What is the meaning of Kalabhairava Sahasranama?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "Sahasranama means 'thousand names.' In this context it refers to devotional names that describe the forms, qualities, and spiritual attributes of Kalabhairava.",
				},
			},
		],
	},
];
---

<PothiLayout
	title={title}
	description={description}
	canonical={canonical}
	schemas={homeSchemas}
	ogType="website"
	ogLocale="en_IN"
	reader
	wide
>
	<Fragment slot="head">
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Kalabhairava Sahasranama" />
		<meta name="application-name" content="Kalabhairava Sahasranama" />
		<meta name="geo.region" content="IN" />
		<meta name="geo.placename" content="India" />
		<meta name="language" content="English" />
		<meta name="coverage" content="Worldwide" />
		<meta name="distribution" content="Global" />
		<meta name="rating" content="General" />
		<meta name="revisit-after" content="7 days" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs text summary" />
		<link
			rel="preload"
			href="/kalabhairava-bg-desktop.webp"
			as="image"
			fetchpriority="high"
		/>

		<!-- Google tag, deferred exactly as before the redesign. -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("consent", "default", { analytics_storage: "granted" });
		</script>
		<script is:inline>
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", function () {
					loadGoogleAnalytics();
				});
			} else {
				loadGoogleAnalytics();
			}

			function loadGoogleAnalytics() {
				const script = document.createElement("script");
				script.async = true;
				script.src = "https://www.googletagmanager.com/gtag/js?id=G-7MXEHWVXYL";
				document.head.appendChild(script);
				script.onload = function () {
					gtag("config", "G-7MXEHWVXYL", { send_page_view: true });
				};
			}
		</script>
	</Fragment>

	<section class="cover">
		<div class="frontis">
			<img
				src="/kalabhairava-bg-desktop.webp"
				alt="Sri Kalabhairava"
				width="1920"
				height="1080"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<span class="plate">Frontispiece · Sri Kalabhairava</span>
		</div>
		<div class="cover-copy">
			<p class="kicker">1,000 names · Kalabhairava Sahasranama</p>
			<h1 lang="sa"><span class="lt">कालभैरव</span><span class="lt">सहस्रनाम</span></h1>
			<p class="lat-title">Kālabhairava Sahasranāma</p>
			<div class="colophon">
				<div><b>{totalCount.toLocaleString("en-US")}</b>names</div>
				<div><b>{totalSets}</b>sets of eleven</div>
				<div><b>{ranges.length}</b>ranges</div>
			</div>
			<p class="lede">
				A free devotional reference for the Kalabhairava Sahasranama: 1,000 names of Sri
				Kalabhairava with English one-line meanings and longer explanations for
				<em>chanting, study, and spiritual reflection</em>.
			</p>
			<a class="open" href="#read">Open the book <span class="ar" aria-hidden="true">→</span></a>
			<p class="small">
				The first set of eleven is ready, with Devanagari, IAST and the meaning. Every
				name links to its own page.
			</p>
		</div>
	</section>

	<section class="reader" id="read">
		<div class="spread-head">
			<span>कालभैरव सहस्रनाम</span>
			<span>Set <b id="headSet">{folio(firstSet.number)}</b> of {totalSets} · names <b id="headRange">{firstSet.label}</b> of {totalCount.toLocaleString("en-US")}</span>
		</div>

		<div class="spread">
			<div class="mindex" id="mindex">
				<div class="mfind">
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg
					>
					<input
						id="mq"
						type="search"
						placeholder="find a name or meaning"
						autocomplete="off"
						aria-label="Search this set"
					/>
					<span class="mc" id="mcount" role="status" aria-live="polite">{firstSet.entries.length} names</span>
				</div>
				<ol class="mlist" id="mlist">
					{firstSet.entries.map((entry, index) => (
						<li data-search={searchText(entry)}>
							<button
								type="button"
								data-i={index}
								aria-current={index === 0 ? "true" : undefined}
								aria-label={`Name ${entry.index}: ${entry.spelling_common}`}
							>
								<span class="n">{folio(entry.index)}</span>
								<span>
									<span class="w" lang="sa">{entry.devanagari}</span>
									<span class="i">{entry.iast}</span>
								</span>
							</button>
						</li>
					))}
					<li class="none" id="mNone">No name in this set matches that search.</li>
				</ol>
			</div>

			<div class="leaf-left">
				<div class="leaf-head">
					<h2>पाठ · this set</h2>
					<span id="listCount">{firstSet.entries.length} names</span>
				</div>
				<div class="find">
					<svg viewBox="0 0 24 24" aria-hidden="true"
						><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg
					>
					<input
						id="q"
						type="search"
						placeholder="find a name or meaning"
						autocomplete="off"
						aria-label="Search this set"
					/>
					<span class="count" id="findCount" role="status" aria-live="polite"></span>
				</div>
				<ul class="toc" id="toc">
					{firstSet.entries.map((entry, index) => (
						<li data-search={searchText(entry)}>
							<button
								type="button"
								data-i={index}
								aria-current={index === 0 ? "true" : undefined}
							>
								<span class="n">{folio(entry.index)}</span>
								<span>
									<span class="w" lang="sa">{entry.devanagari}</span>
									<span class="i">{entry.iast}</span>
								</span>
							</button>
						</li>
					))}
				</ul>
				<div class="foot">
					<span>Page <b id="footPage">1</b> of the set</span><span>{totalSets} sets</span>
				</div>
			</div>

			<div class="leaf-right" id="page" aria-live="polite">
				<div class="page-eyebrow">
					<span>Name {folio(first.index)} of {totalCount.toLocaleString("en-US")}</span>
					<span>अर्थ · meaning</span>
				</div>
				<h2 class="page-name" lang="sa">{first.devanagari}</h2>
				<p class="page-iast">{first.iast}</p>
				<p class="page-one">{first.english_one_line}</p>
				<div class="page-rule"></div>
				<div class="page-elab">
					{firstBlocks.map((block) =>
						block.type === "h3" ? <h3>{block.text}</h3> : <p>{block.text}</p>,
					)}
				</div>
				<div class="page-foot">
					<a class="u src" href={`/names/${first.page_slug}/`}
						>Read the full note on the site</a
					>
					<span class="folio">{folio(first.index)}</span>
				</div>
			</div>
		</div>

		<div class="turn">
			<button id="prev" type="button" disabled>← previous set</button>
			<span class="mid">set <b id="setNo">{folio(firstSet.number)}</b> / {totalSets}</span>
			<button id="next" type="button" disabled={totalSets <= 1}>next set →</button>
		</div>
		<p class="reader-status" id="readerStatus" role="status" aria-live="polite"></p>
	</section>

	<section class="essay" id="about">
		<div class="essay-inner">
			<div>
				<h2>टिप्पणी</h2>
				<p class="h-sub">About this book</p>
			</div>
			<div class="essay-body">
				<p>
					<strong>What this is:</strong> a free devotional reference for the Kalabhairava
					Sahasranama, with 1,000 names of Sri Kalabhairava, their Devanagari and IAST
					forms, a one-line meaning and a longer note for each. There are no accounts and no
					paywall.
				</p>
				<p>
					<strong>How it is arranged:</strong> the text is read in {totalSets} sets of eleven
					names — the last set holds ten — and in {ranges.length} ranges of one hundred.
					Every name has its own page with alternate spellings and the full note.
				</p>
				<p>
					<strong>Where the text comes from:</strong> the name list follows the Kalabhairava
					Sahasranama as compiled for this project. The English notes are devotional and
					interpretive, not a translation of a single critical edition. Read the
					<a class="u" href="/sources/">sources and editorial notes</a> for the method and
					the correction path. The same text is available as a
					<a class="u" href="/downloads/kalabhairava-sahasranama-names.pdf">free printable PDF</a>.
				</p>

				<details class="note-disclosure">
					<summary>Questions about the text</summary>
					<div class="faq-list">
						<article class="faq-item">
							<h3>What is Kalabhairava 1000 Names?</h3>
							<p>
								Kalabhairava 1000 Names, also called Kalabhairava Sahasranama, is a
								devotional collection of sacred names of Lord Kalabhairava with English
								meanings for chanting, study, and spiritual reflection.
							</p>
						</article>
						<article class="faq-item">
							<h3>How many names are in this Kalabhairava Sahasranama?</h3>
							<p>
								This site presents 1,000 names of Kalabhairava. Each entry includes a
								one-line English meaning and a longer explanatory note.
							</p>
						</article>
						<article class="faq-item">
							<h3>Where can I browse all names with meanings?</h3>
							<p>
								You can read the interactive homepage reader or use the
								<a class="u" href="/names/">static names reference hub</a>, which links
								to crawlable range pages for the full collection.
							</p>
						</article>
						<article class="faq-item">
							<h3>What does Sahasranama mean?</h3>
							<p>
								Sahasranama means “thousand names.” In this context it refers to
								devotional names that describe the forms, qualities, and spiritual
								attributes of Kalabhairava.
							</p>
						</article>
					</div>
				</details>
			</div>
		</div>
	</section>

	<script type="application/json" id="pothi-index" set:html={indexJson} />
	<script type="application/json" id="pothi-boot" set:html={bootJson} />
	<script src="/pothi-reader.js" defer></script>
</PothiLayout>
