---
import PothiLayout from '../../layouts/PothiLayout.astro';

const siteUrl = 'https://bhairavakalikenamosthute.com';
const canonical = `${siteUrl}/kalabhairava-sahasranama-pdf/`;
const title = 'Kalabhairava Sahasranama PDF — Free English Download (1000 Names) | Kalabhairava 1000 Names';
const description =
	'Download the free Kalabhairava Sahasranama PDF in English: a printable 66-page A4 edition of the 1,000 names of Kalabhairava with Devanagari, spellings and meanings, plus archive.org editions.';

const printablePdf = '/downloads/kalabhairava-sahasranama-names.pdf';
const archiveEnglish =
	'https://archive.org/details/Kalabhairava-sahasranama-kaliputraashish';
const archiveHindi =
	'https://archive.org/details/Kalabhairava-sahasranama-in-Hindi-kaliputraashish';
const archiveSecondEdition =
	'https://archive.org/details/kalabhairavaBaba_1000names_ebook_Final_SecondDigitalEdition';

const faqs = [
	{
		question: 'Is there a Kalabhairava Sahasranama PDF in English?',
		answer:
			'Yes. This site offers a free printable English edition of the 1,000-name Kalabhairava Sahasranama as a PDF, with Devanagari, common English spellings, IAST transliteration and short meanings. Archive.org editions are also linked on this page.',
	},
	{
		question: 'Is the Kalabhairava Sahasranama PDF free?',
		answer:
			'Yes. The printable edition generated from this site and the archive.org editions are offered free for devotional reading and study.',
	},
	{
		question: 'Is there a Hindi Kalabhairava Sahasranama PDF?',
		answer:
			'The printable edition on this site is an English reference with Devanagari names. A separate Hindi edition of the Kalabhairava Sahasranama is published by the same author on archive.org and is linked on this page.',
	},
	{
		question: 'Can I print the PDF?',
		answer:
			'Yes. The printable edition is A4-formatted and designed for home printing, offline reading and chanting support.',
	},
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': `${canonical}#webpage`,
			name: title,
			description,
			url: canonical,
			inLanguage: 'en',
			isPartOf: { '@id': `${siteUrl}/#website` },
		},
		{
			'@type': 'Book',
			'@id': `${canonical}#book`,
			name: 'Kalabhairava Sahasranama — 1000 Names of Kalabhairava (Printable Edition)',
			description:
				'Printable English reference edition of the 1,000-name Kalabhairava Sahasranama with Devanagari, common spellings, IAST transliteration and short meanings.',
			bookFormat: 'https://schema.org/EBook',
			numberOfPages: 66,
			inLanguage: 'en',
			url: `${siteUrl}${printablePdf}`,
			author: { '@type': 'Person', name: 'Kaliputra Ashish' },
			publisher: { '@id': `${siteUrl}/#publisher` },
			about: { '@type': 'Thing', name: 'Kalabhairava Sahasranama' },
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${canonical}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
				{ '@type': 'ListItem', position: 2, name: 'Kalabhairava Sahasranama PDF', item: canonical },
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${canonical}#faq`,
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: { '@type': 'Answer', text: faq.answer },
			})),
		},
	],
};
---

<PothiLayout title={title} description={description} canonical={canonical} schema={schema}>
	<nav class="crumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/">Home</a></li>
			<li><span aria-current="page">Kalabhairava Sahasranama PDF</span></li>
		</ol>
	</nav>

	<p class="kicker">Free downloads</p>
	<h1>Kalabhairava Sahasranama PDF</h1>

	<div class="prose lede" style="margin-top:clamp(22px,3vw,32px)">
		<p>
			Download the Kalabhairava Sahasranama in English as a free PDF. The printable edition contains the
			<strong>1,000 names</strong> of Kalabhairava with Devanagari, common English spellings, IAST
			transliteration and short meanings — 66 A4 pages, about 2.4 MB, made for offline reading and printing. Archive.org editions,
			including a Hindi edition, are also linked below.
		</p>
	</div>

	<section class="guide-section">
		<div class="seealso">
			<a class="tl" href={printablePdf}>
				<span class="t">Download printable PDF (2.4 MB)</span>
				<span class="d"></span>
				<span class="p">pdf</span>
			</a>
			<a class="tl" href={archiveEnglish}>
				<span class="t">English on archive.org</span>
				<span class="d"></span>
				<span class="p">archive.org</span>
			</a>
			<a class="tl" href="/names/">
				<span class="t">Read the names online</span>
				<span class="d"></span>
				<span class="p">names hub</span>
			</a>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">Which download should I use?</h2>
		<div class="prose">
			<h3>Printable web edition</h3>
			<p>
				Text-based, searchable PDF generated from this site's data: 66 pages, A4, about 2.4 MB. Includes every name with Devanagari,
				Devanagari-to-English spellings and the short English meaning. Best for printing, quick reference and
				offline lookup.
			</p>
			<p><a href={printablePdf}>Download PDF</a></p>

			<h3>Archive.org English edition</h3>
			<p>
				Long-term public copies of the Kalabhairava Sahasranama published by the author. Useful as a mirror
				and for citation.
			</p>
			<p><a href={archiveEnglish}>English on archive.org</a></p>

			<h3>Second digital edition</h3>
			<p>
				The revised digital edition of the Kalabhairava 1000 Names ebook, also archived on archive.org.
			</p>
			<p><a href={archiveSecondEdition}>Open second digital edition</a></p>

			<h3>Hindi edition</h3>
			<p>
				A separate Hindi edition is published by the same author on archive.org. It is not hosted or
				maintained on this English site.
			</p>
			<p><a href={archiveHindi}>Hindi on archive.org</a></p>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">What is inside the printable edition</h2>
		<div class="prose">
			<ul>
				<li>A cover with the Kalabhairava devotional image.</li>
				<li>A short introduction on the text and its transliteration choices.</li>
				<li>The full name sequence in Sahasranama order, numbered.</li>
				<li>Devanagari, common English spelling and IAST transliteration for every name.</li>
				<li>A short English meaning for every name.</li>
				<li>Sources, citation links and a correction path.</li>
			</ul>
			<p class="callout">
				Looking for the complete meaning notes rather than the short list? Use the online
				<a href="/names/">names hub</a>: every name links to a page with its longer explanation.
			</p>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">Using and sharing the PDF</h2>
		<div class="prose">
			<p>
				The printable edition is free for personal and devotional use. When sharing, link to this page rather than
				redistributing modified copies, so readers always get the current version. For formal citation, link to the
				specific name page or range page on the website; those HTML pages are the crawlable reference versions.
			</p>
			<p>
				To print, open the PDF in any standard viewer and choose actual size (100%) on A4 paper. Black-and-white
				printing is fine; the Devanagari column remains legible.
			</p>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">Questions about the Kalabhairava Sahasranama PDF</h2>
		<div class="prose">
			<div class="faq-list">
				{faqs.map((faq) => (
					<article class="faq-item">
						<h3>{faq.question}</h3>
						<p>{faq.answer}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">Continue reading</h2>
		<div class="prose">
			<ul>
				<li><a href="/108-names-of-kalabhairava/">108 names of Kalabhairava with meanings</a></li>
				<li><a href="/1000-names-of-kalabhairava/">How the 1,000-name count works</a></li>
				<li><a href="/kalabhairava-sahasranama-lyrics/">Kalabhairava Sahasranama lyrics and chant order</a></li>
				<li><a href="/kalabhairava-sahasranama-benefits/">Kalabhairava Sahasranama benefits</a></li>
				<li><a href="/sources/">Sources and editorial notes</a></li>
			</ul>
		</div>
	</section>
</PothiLayout>
