---
import PothiLayout from '../../layouts/PothiLayout.astro';

const siteUrl = 'https://bhairavakalikenamosthute.com';
const canonical = `${siteUrl}/contact/`;
const title = 'Contact & Corrections | Kalabhairava 1000 Names';
const description =
	'How to contact the Kalabhairava 1000 Names project and report spelling, meaning, attribution or source corrections.';

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ContactPage',
			'@id': `${canonical}#webpage`,
			name: title,
			description,
			url: canonical,
			inLanguage: 'en',
			isPartOf: { '@id': `${siteUrl}/#website` },
			mainEntity: { '@id': `${siteUrl}/#publisher` },
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${canonical}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
				{ '@type': 'ListItem', position: 2, name: 'Contact', item: canonical },
			],
		},
	],
};
---

<PothiLayout title={title} description={description} canonical={canonical} schema={schema}>
	<nav class="crumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/">Home</a></li>
			<li><span aria-current="page">Contact</span></li>
		</ol>
	</nav>

	<p class="kicker">Contact and corrections</p>
	<h1>Contact &amp; Corrections</h1>

	<div class="prose lede" style="margin-top:clamp(22px,3vw,32px)">
		<p>
			Corrections and questions about the Kalabhairava 1000 Names project are welcome. The most reliable route is
			the public repository, where a correction can be reviewed and tracked in the open. Email and Instagram are
			also available.
		</p>
	</div>

	<section class="guide-section">
		<div class="seealso">
			<a class="tl" href="https://github.com/09ashishkapoor/kalabhairava1000names/issues" rel="noopener noreferrer"
				><span class="t">Open a GitHub issue</span><span class="d"></span><span class="p"
					>repository</span
				></a
			>
			<a class="tl" href="mailto:kaliputraashish@gmail.com"
				><span class="t">Email the maintainer</span><span class="d"></span><span class="p"
					>email</span
				></a
			>
			<a class="tl" href="https://www.instagram.com/ashishkaliputra" rel="noopener noreferrer"
				><span class="t">Message on Instagram</span><span class="d"></span><span class="p"
					>instagram</span
				></a
			>
			<a class="tl" href="/about/"
				><span class="t">About the author</span><span class="d"></span><span class="p"
					>about</span
				></a
			>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">Reporting a correction</h2>
		<div class="prose">
			<p>Please include as much of the following as you can:</p>
			<ul>
				<li>The name number or page URL, for example <code>/names/bhairavaya/</code>.</li>
				<li>The current text and what you believe it should be.</li>
				<li>Any source, edition or manuscript reference that supports the correction.</li>
				<li>Whether the issue is spelling, transliteration, meaning, attribution or a broken link.</li>
			</ul>
			<p>
				Corrections that include a source are easiest to verify. Devotional spelling and transliteration vary
				between traditions, so the project aims to note differences rather than flatten them.
			</p>
		</div>
	</section>

	<section class="guide-section">
		<h2 class="sec">What to expect</h2>
		<div class="prose">
			<p>
				This is a personal devotional project maintained in spare time. There is no formal support desk or
				response-time guarantee. Reviewable GitHub issues are preferred because they keep the correction history
				public.
			</p>
			<p>
				For source and citation questions, see the <a href="/sources/">sources and editorial notes</a> page. For
				privacy questions, see the <a href="/privacy/">privacy policy</a>.
			</p>
		</div>
	</section>
</PothiLayout>
