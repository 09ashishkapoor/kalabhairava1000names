---
// Shared layout for every reference page on the site (everything except the
// interactive landing page at /). It uses the chrome and design system of the
// sister site https://jaikhyapaparampara.com/.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const versionJson = JSON.parse(
	readFileSync(join(process.cwd(), 'public', 'version.json'), 'utf8'),
);
const siteVersion = versionJson.version || '1.0';
const lastUpdatedDisplay = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(new Date());

const {
	title,
	description,
	canonical,
	schema = null,
	robots = 'index,follow,max-image-preview:large,max-snippet:-1',
	ogType = 'article',
	prevUrl = null,
	nextUrl = null,
} = Astro.props;

const path = Astro.url.pathname;
const siteName = 'Kalabhairava 1000 Names';
const ogImage = 'https://bhairavakalikenamosthute.com/kalabhairava-bg-desktop.webp';

const navItems = [
	{ label: 'Names', href: '/names/' },
	{ label: '108 Names', href: '/108-names-of-kalabhairava/' },
	{ label: '1000 Names', href: '/1000-names-of-kalabhairava/' },
	{ label: 'Free PDFs', href: '/kalabhairava-sahasranama-pdf/' },
	{ label: 'Lyrics', href: '/kalabhairava-sahasranama-lyrics/' },
	{ label: 'Benefits', href: '/kalabhairava-sahasranama-benefits/' },
	{ label: 'About', href: '/about/' },
];

function isCurrent(href) {
	if (href === '/names/') {
		return path === '/names/' || path.startsWith('/names/');
	}
	return path === href || path.startsWith(href);
}
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="author" content="KaliPutra-Ashish" />
		<meta name="google" content="notranslate" />
		<meta name="theme-color" content="#8B2635" />
		<link rel="canonical" href={canonical} />
		{prevUrl && <link rel="prev" href={prevUrl} />}
		{nextUrl && <link rel="next" href={nextUrl} />}

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Kalabhairava - Divine Goddess Kali" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Kalabhairava - Divine Goddess Kali" />

		<link rel="icon" type="image/webp" href="/kalabhairava-bg-desktop.webp" />
		<link rel="apple-touch-icon" href="/kalabhairava-bg-desktop.webp" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Philosopher:wght@400;700&display=swap"
			as="style"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Philosopher:wght@400;700&display=swap"
				rel="stylesheet"
			/>
		</noscript>
		<link rel="stylesheet" href="/reference.css" />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="site-shell site-header-inner">
				<a class="site-logo" href="/" translate="no">Kalabhairava 1000 Names</a>
				<div class="site-header-actions">
					<a
						class="site-icon-btn"
						href="/"
						aria-label="Open the interactive reader"
						title="Interactive reader"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><path d="M12 6.5C10.5 5.2 8.6 4.5 6.5 4.5H4v14h2.5c2.1 0 4 .7 5.5 2 1.5-1.3 3.4-2 5.5-2H20v-14h-2.5c-2.1 0-4 .7-5.5 2Z"></path><path
								d="M12 6.5v14"
							></path></svg
						>
					</a>
					<button
						class="site-nav-toggle"
						type="button"
						aria-label="Open menu"
						aria-expanded="false"
						aria-controls="site-menu"
					>
						<span></span><span></span><span></span>
					</button>
				</div>
				<nav id="site-menu" class="site-menu" aria-label="Primary">
					<ul class="site-menu-list">
						<li class="site-menu-start"><a href="/">Start Here</a></li>
						{navItems.map((item) => (
							<li>
								<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
					<div class="site-menu-more">
						<span>More</span>
						<a href="/sources/">Sources</a>
						<a href="/contact/">Contact</a>
						<a href="/privacy/">Privacy</a>
						<a href="https://jaikhyapaparampara.com/" target="_blank" rel="noopener">Sister site ↗</a>
					</div>
				</nav>
			</div>
		</header>

		<main id="main" class="reference-main" tabindex="-1">
			<div class="site-shell reference-shell">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="site-footer-inner">
				<p class="site-footer-blessing">Om Shri Gurubhyo Namaha | Jai Khyapa Parampara</p>
				<p class="site-footer-desc">May every word read here bring you closer to Ma Kalabhairava.</p>
				<nav class="site-footer-links" aria-label="Footer">
					<a href="/">Interactive reader</a>
					<a href="/names/">Names hub</a>
					<a href="/108-names-of-kalabhairava/">108 Names</a>
					<a href="/1000-names-of-kalabhairava/">1000 Names</a>
					<a href="/kalabhairava-sahasranama-pdf/">Free PDFs</a>
					<a href="/kalabhairava-sahasranama-lyrics/">Lyrics</a>
					<a href="/kalabhairava-sahasranama-benefits/">Benefits</a>
					<a href="/sources/">Sources</a>
					<a href="/about/">About</a>
					<a href="/contact/">Contact</a>
					<a href="/privacy/">Privacy</a>
					<a href="https://jaikhyapaparampara.com/" target="_blank" rel="noopener">Sister site ↗</a>
				</nav>
				<p class="site-footer-meta">
					&copy; <span data-current-year>2026</span> KaliPutra-Ashish. All knowledge is forever free to share.
				</p>
				<p class="site-footer-meta">
					<a href="https://github.com/09ashishkapoor/1000namesofmaadya" target="_blank" rel="noopener"
						>Open source on GitHub</a
					>
				</p>
				<p class="site-footer-version">Version V{siteVersion} &middot; Last updated {lastUpdatedDisplay}</p>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var year = new Date().getFullYear();
				document.querySelectorAll('[data-current-year]').forEach(function (node) {
					node.textContent = year;
				});

				var header = document.querySelector('.site-header');
				if (!header) return;
				var toggle = header.querySelector('.site-nav-toggle');
				var menu = header.querySelector('#site-menu');
				if (!toggle || !menu) return;

				function closeMenu() {
					menu.classList.remove('is-open');
					toggle.setAttribute('aria-expanded', 'false');
					toggle.setAttribute('aria-label', 'Open menu');
					document.body.classList.remove('site-nav-open');
				}

				function openMenu() {
					menu.classList.add('is-open');
					toggle.setAttribute('aria-expanded', 'true');
					toggle.setAttribute('aria-label', 'Close menu');
					document.body.classList.add('site-nav-open');
				}

				toggle.addEventListener('click', function () {
					if (menu.classList.contains('is-open')) closeMenu();
					else openMenu();
				});

				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape' && menu.classList.contains('is-open')) {
						closeMenu();
						toggle.focus();
					}
				});

				document.addEventListener('click', function (event) {
					if (menu.classList.contains('is-open') && !header.contains(event.target)) closeMenu();
				});

				window.addEventListener('resize', function () {
					if (window.innerWidth > 900) closeMenu();
				});

				menu.querySelectorAll('a').forEach(function (link) {
					link.addEventListener('click', closeMenu);
				});
			})();
		</script>
	</body>
</html>
