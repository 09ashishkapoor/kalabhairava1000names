                <small><span data-i18n="footer.lastUpdated">Last Updated:</span> <span id="last-updated-date">December 22, 2025</span></small>
                <script>
                    (function(){
                        var el = document.querySelector('.site-version');
                        if (!el) return;
                        if (el.textContent.trim() !== '') return;

                        // Try to compute a simple version from GitHub commit count on main: v1.<commit-count>
                        var owner = '09ashishkapoor';
                        var repo = 'kalabhairava1000names';
                        var commitsApi = 'https://api.github.com/repos/' + owner + '/' + repo + '/commits?sha=main&per_page=1';

                        function setFallback() {
                            // Fallback to reading version.txt if GitHub API fails or rate-limited
                            fetch('/version.txt').then(function(r){ if(r.ok) return r.text(); throw new Error('no'); }).then(function(t){ el.textContent = t.trim(); }).catch(function(){ /* ignore */ });
                        }

                        fetch(commitsApi, { cache: 'no-store' }).then(function(r){
                            if (!r.ok) throw new Error('no-github');
                            var link = r.headers.get('Link');
                            if (link) {
                                // Parse last page number from Link header which indicates total commits when per_page=1
                                var m = link.match(/[?&]page=(\d+)>; rel="last"/);
                                if (m && m[1]) {
                                    var count = parseInt(m[1], 10);
                                    if (!isNaN(count)) {
                                        el.textContent = 'v1.' + count;
                                        return;
                                    }
                                }
                            }
                            // If no Link header, try reading response body length
                            return r.json().then(function(js){
                                if (js && js.length) {
                                    // Only one commit returned; treat as v1.1
                                    el.textContent = 'v1.1';
                                } else {
                                    throw new Error('no-commits');
                                }
                            });
                        }).catch(function(){
                            setFallback();
                        });
                    })();
                    // Set last updated date using GitHub commit date (fallback to /last-updated.txt)
                    (function(){
                        var dateEl = document.getElementById('last-updated-date');
                        if (!dateEl) return;

                        // Try GitHub API first to get the latest commit on main
                        var owner = '09ashishkapoor';
                        var repo = 'kalabhairava1000names';
                        var commitsApi = 'https://api.github.com/repos/' + owner + '/' + repo + '/commits?sha=main&per_page=1';

                        function formatDateISO(isoStr) {
                            try {
                                var d = new Date(isoStr);
                                var opts = { year: 'numeric', month: 'long', day: 'numeric' };
                                return d.toLocaleDateString('en-US', opts);
                            } catch (e) {
                                return isoStr;
                            }
                        }

                        fetch(commitsApi, { cache: 'no-store' }).then(function(r){
                            if (!r.ok) throw new Error('no-github');
                            return r.json();
                        }).then(function(js){
                            if (js && js.length && js[0].commit && js[0].commit.committer && js[0].commit.committer.date) {
                                dateEl.textContent = formatDateISO(js[0].commit.committer.date);
                                return;
                            }
                            throw new Error('no-date');
                        }).catch(function(){
                            // Fallback to reading last-updated.txt from the site root
                            fetch('/last-updated.txt').then(function(r){ if(r.ok) return r.text(); throw new Error('no'); }).then(function(dateStr){
                                var dateStrTrimmed = dateStr.trim();
                                if (dateStrTrimmed) {
                                    var parts = dateStrTrimmed.split('-');
                                    if (parts.length === 3) {
                                        var date = new Date(parts[0], parts[1] - 1, parts[2]);
                                        var options = { year: 'numeric', month: 'long', day: 'numeric' };
                                        dateEl.textContent = date.toLocaleDateString('en-US', options);
                                    } else {
                                        dateEl.textContent = dateStrTrimmed;
                                    }
                                    return;
                                }
                                // Final fallback: use today's date
                                var lastUpdated = new Date();
                                var options = { year: 'numeric', month: 'long', day: 'numeric' };
                                dateEl.textContent = lastUpdated.toLocaleDateString('en-US', options);
                            }).catch(function(){
                                var lastUpdated = new Date();
                                var options = { year: 'numeric', month: 'long', day: 'numeric' };
                                dateEl.textContent = lastUpdated.toLocaleDateString('en-US', options);
                            });
                        });
                    })();
                </script>
        </div>
    </footer>
    
    <!-- Scripts -->
    <script src="translations.js?v=2"></script>
    <script src="i18n.js?v=2"></script>
    <script src="navigation.js?v=2" defer></script>
    <script src="app.js?v=2" defer></script>
    <script src="registerSW.js" defer></script>

    <noscript>
        <section class="static-names-list">
            <h3>Complete List of 1000 Names of Kalabhairava</h3>
            <ul><li><strong>Bhairavaaya (भैरवाय)</strong>: Salutations To The one who is terrifying and destroys fear.</li><li><strong>Bhuutanaathaaya (भूतनाथाय)</strong>: Salutations To The  lord and master of all beings, including ghosts and spirits.</li><li><strong>Bhuutaatmane (भूतात्मने)</strong>: Salutations To The one who is the very soul and essence of all living beings.</li><li><strong>Bhuutabhaavanaaya (भूतभावनाय)</strong>: Salutations To The  creator and nurturer of all beings in the universe.</li><li><strong>Bhuutavaasaaya (भूतवासाय)</strong>: Salutations To The one who resides within all of existence and in whom all beings dwell.</li><li><strong>Bhuutaduutaaya (भूतदूताय)</strong>: Salutations To The one who has ghosts and spirits as his messengers.</li><li><strong>Bhuurishaaya (भूरिशाय)</strong>: Salutations To The one who possesses great wealth and abundance.</li><li><strong>Bhuuridakshinaaya (भूरिदक्षिणाय)</strong>: Salutations To The one who is extremely generous and gives great rewards.</li><li><strong>Bhuutaadhyakshaaya (भूताध्यक्षाय)</strong>: Salutations To The  supreme overseer and presides over all beings.</li><li><strong>Bhuutapataye (भूतपतये)</strong>: Salutations To The  commander and protector of all beings.</li><li><strong>Bhuudharaaya (भूधराय)</strong>: Salutations To The one who supports the Earth.</li><li><strong>Bhuudharaatmajaaya (भूधरात्मजाय)</strong>: Salutations To The  son of the mountain-bearer (often referring to Parvati's son, but here an epithet of Bhairava's power).</li><li><strong>Bhuupataye (भूपतये)</strong>: Salutations To The  supreme lord of the Earth.</li><li><strong>Bhaaskaraaya (भास्कराय)</strong>: Salutations To The one who is radiant and effulgent like the sun.</li><li><strong>Bhiirave (भीरोवे)</strong>: Salutations To The one who is formidable and inspires awe.</li><li><strong>Bhiimaaya (भीमाय)</strong>: Salutations To The one who is of immense and dreadful strength.</li><li><strong>Bhuumaye (भूमये)</strong>: Salutations To The one who is the Earth itself.</li><li><strong>Vibhuutidaaya (विभूतिदायाय)</strong>: Salutations To The  bestower of divine powers, prosperity, and sacred ash.</li><li><strong>Bhuutaaya (भूताय)</strong>: Salutations To The one who has come into being and exists as all of creation.</li><li><strong>Bhuukampanaaya (भूकम्पनाय)</strong>: Salutations To The one who can cause the earth to tremble.</li><li><strong>Bhuuminaamne (भूमिनाम्ने)</strong>: Salutations To The one who is known by all the names of the Earth.</li><li><strong>Bhuutaabhibhaavakaaya (भूताभिभावकाय)</strong>: Salutations To The one who evokes and manifests spirits.</li><li><strong>Bhaganetraaya (भगनेत्राय)</strong>: Salutations To The one who possesses the eyes of Bhaga (a Vedic deity of wealth and prosperity).</li><li><strong>Bhavaaya (भवाय)</strong>: Salutations To The one who is existence itself.</li><li><strong>Bhoktre (भोक्त्रे)</strong>: Salutations To The one who is the ultimate enjoyer and experiencer.</li><li><strong>Bhuudevaaya (भूदेवाय)</strong>: Salutations To The one who is a god on Earth.</li><li><strong>Bhagavate (भगवते)</strong>: Salutations To The  divine and glorious Lord.</li><li><strong>Rathine (रथिणे)</strong>: Salutations To The one who rides a chariot, symbolizing a master of his journey.</li><li><strong>Bhraajishnave (भ्राजिष्णवे)</strong>: Salutations To The one who is brilliantly radiant and shines splendidly.</li><li><strong>Bhojanaaya (भोजनाय)</strong>: Salutations To The one who is the embodiment of all food and nourishment.</li><li><strong>Bhoktre (भोक्त्रे)</strong>: Salutations To The one who is the ultimate enjoyer and experiencer of all things.</li><li><strong>Bhikshaabhuje (भिक्षाभुजे)</strong>: Salutations To The one who consumes food offered as alms, representing detachment.</li><li><strong>Bhojanapriyaaya (भोजनप्रियाय)</strong>: Salutations To The one who is fond of food and offerings.</li><li><strong>Bhuutimayaaya (भूतिमयाय)</strong>: Salutations To The one who is entirely composed of sacred ash and divine glory.</li><li><strong>Bhringgiritine (भृंगगिरिटीने)</strong>: Salutations To The one who is accompanied by the devoted sage Bhringi.</li><li><strong>Bhaktasaadhitavigrahaaya (भक्तसाधितविग्रहाय)</strong>: Salutations To The one whose divine form is attainable through the devotion of his followers.</li><li><strong>Bhuutacaarine (भूतचारिणे)</strong>: Salutations To The one who wanders among ghosts and elemental spirits.</li><li><strong>Nishaacaarine (निशाचारिणे)</strong>: Salutations To The one who wanders in the darkness of the night.</li><li><strong>Pretacaarine (प्रेतचारिणे)</strong>: Salutations To The one who moves among the spirits of the deceased.</li><li><strong>Bhayaanakaaya (भयानकाय)</strong>: Salutations To The one who is of a terrifying and fearsome appearance.</li><li><strong>Bhavaatmane (भवात्मने)</strong>: Salutations To The one who is the very soul of existence and creation.</li><li><strong>Bhuurbhuvolakshmyai (भूर्भुवोलक्ष्म्यै)</strong>: Salutations To The one who is the splendor and glory of the three worlds (Earth, Atmosphere, and Heavens).</li><li><strong>Bhuutimate (भूतिमाते)</strong>: Salutations To The one who possesses immense divine powers and prosperity.</li><li><strong>Bhavavikramaaya (भवविक्रमाय)</strong>: Salutations To The one whose prowess and might bring about creation.</li><li><strong>Padmagarbhaaya (पद्मगर्भाय)</strong>: Salutations To The one who has a lotus at his navel, from which creation arises.</li><li><strong>Mahaagarbhaaya (महागर्भाय)</strong>: Salutations To The one who contains the great cosmic womb within himself.</li><li><strong>Vishvagarbhaaya (विश्वगर्भ्याय)</strong>: Salutations To The one who contains the entire universe within his being.</li><li><strong>Bhuve (भुवे)</strong>: Salutations To The one who is the very embodiment of the Earth and existence.</li><li><strong>Abhuve (अभूवे)</strong>: Salutations To The one who is unborn, transcending all existence.</li><li><strong>Bhuutatvaaya (भूतत्वाय)</strong>: Salutations To The one who represents the fundamental essence of all beings.</li><li><strong>Bhuvanaadhiishaaya (भुवनाधीशाय)</strong>: Salutations To The  supreme ruler of all the worlds.</li><li><strong>Bhuutikrite (भूति कृते)</strong>: Salutations To The one who creates prosperity and well-being.</li><li><strong>Bhraantinaashanaaya (भ्रान्तिनाशनाय)</strong>: Salutations To The  destroyer of all confusion and delusion.</li><li><strong>Bhuutibhuushitasarvaanggaaya (भूतिभूषितसर्वांगाय)</strong>: Salutations To The one whose entire body is adorned with sacred ash.</li><li><strong>Bhuushayaaya (भूषयाय)</strong>: Salutations To The one who is the source of all adornment.</li><li><strong>Bhuutavaahanaaya (भूतवाहनाय)</strong>: Salutations To The one who has spirits and ghosts as his vehicle.</li><li><strong>Kshetrajnaaya (क्षेत्रज्ञाय)</strong>: Salutations To The one who is the ultimate knower of the field (the body and all of creation).</li><li><strong>Bhuvanaadhiishaaya (भुवनाधीशाय)</strong>: Salutations To The  supreme lord and ruler of all worlds.</li><li><strong>Bhuutidaaya (भूतिदाय)</strong>: Salutations To The  bestower of well-being, prosperity, and supernatural powers.</li><li><strong>Bhuutimate (भूतिमाते)</strong>: Salutations To The one who is possessed of great power, glory, and being.</li><li><strong>Prabhave (प्रभवे)</strong>: Salutations To The  supreme, mighty, and all-powerful Lord.</li><li><strong>Kshetrajnaaya (क्षेत्रज्ञाय)</strong>: Salutations To The  knower of the field of existence.</li><li><strong>Kshetrapaalaaya (क्षेत्रपालाय)</strong>: Salutations To The  ultimate guardian and protector of the sacred field or domain.</li><li><strong>Kshetravighnanivaaranaaya (क्षेत्रविघ्ननिवारणाय)</strong>: Salutations To The  remover of all obstacles within the sacred field of life.</li><li><strong>Kshaantaaya (क्षान्ताय)</strong>: Salutations To The one who is supremely patient, tranquil, and forgiving.</li><li><strong>Kshudraaya (क्षुद्राय)</strong>: Salutations To The one who can assume a minute form or attend Salutations To The  smallest of beings.</li><li><strong>Kshetrapaaya (क्षेत्रपाय)</strong>: Salutations To The  protector of the land and the sacred field.</li><li><strong>Kshudraghnaaya (क्षुद्रघ्नाय)</strong>: Salutations To The  destroyer of the petty-minded, the wicked, and the insignificant.</li><li><strong>Kshatrapaaya (क्षत्रपाय)</strong>: Salutations To The  protector of the domain, a true sovereign.</li><li><strong>Kshamine (क्षमिणे)</strong>: Salutations To The one who is the very embodiment of forgiveness and forbearance.</li><li><strong>Kshobhanaaya (क्षोभनाय)</strong>: Salutations To The one who causes agitation, shaking beings out of ignorance and inertia.</li><li><strong>Maaranaaya (मारणाय)</strong>: Salutations To The one who wields the power of death and destruction against evil.</li><li><strong>Stambhanaaya (स्तम्भनाय)</strong>: Salutations To The one who can paralyze, halt, or immobilize any opposing force.</li><li><strong>Mohanaaya (मोहनाय)</strong>: Salutations To The one who has the power to delude, enchant, and captivate all beings.</li><li><strong>Namanaaya (नमन्याय)</strong>: Salutations To The one who is worthy of all reverence and to whom all must bow.</li><li><strong>Vashine (वशीने)</strong>: Salutations To The one who has everyone and everything under his control.</li><li><strong>Kshapanaaya (क्षपणाय)</strong>: Salutations To The one who brings about the destruction or expiation of sins.</li><li><strong>Kshaantidaaya (क्षान्तिदाय)</strong>: Salutations To The one who is the bestower of patience and tranquility.</li><li><strong>Kshaamaaya (क्षमाया)</strong>: Salutations To The one who is patient, peaceful, and enduring.</li><li><strong>Kshamine (क्षमिणे)</strong>: Salutations To The one who is the very embodiment of forgiveness and forbearance.</li><li><strong>Kshetradharaaya (क्षेत्रधाराय)</strong>: Salutations To The one who upholds and supports the entire field of existence.</li><li><strong>Ksharaaya (क्षाराय)</strong>: Salutations To The one who is the perishable form of all things, yet also the imperishable reality.</li><li><strong>Kangkaalaaya (कंकालाय)</strong>: Salutations To The one who has a skeletal form, symbolizing transcendence over the physical body.</li><li><strong>Kaalashamanaaya (कालशमनाय)</strong>: Salutations To The one who pacifies and subdues time and death.</li><li><strong>Kalaakaashthaayai (कालाकाष्ठयै)</strong>: Salutations To The one who is the ultimate limit and the smallest unit of time.</li><li><strong>Kalaanidhaye (कलानिधये)</strong>: Salutations To The one who is the great treasure-house of all arts and skills.</li><li><strong>Kaalaaya (कालाय)</strong>: Salutations To The one who is Time itself, the ultimate destroyer and sustainer.</li><li><strong>Karaalaaya (करालाय)</strong>: Salutations To The one with a gaping mouth and a fearsome, formidable appearance.</li><li><strong>Kangkaaline (कंकालिने)</strong>: Salutations To The one who wears a garland of skulls, symbolizing detachment from the ego.</li><li><strong>Kamaniiyaaya (कमनीयाय)</strong>: Salutations To The one who is supremely beautiful, charming, and desirable.</li><li><strong>Kalaanidhaye (कलानिधये)</strong>: Salutations To The one who is a repository of all arts and divine qualities.</li><li><strong>Kaalaaya (कालाय)</strong>: Salutations To The one who is the embodiment of time and destiny.</li><li><strong>Kaalaakritaye (कालाकृतये)</strong>: Salutations To The one who is the creator and shaper of time itself.</li><li><strong>Vaayave (वायवे)</strong>: Salutations To The one who is the vital life-breath (Vayu) and the cosmic wind.</li><li><strong>Kapardine (कपर्दिने)</strong>: Salutations To The one with thick, matted, and coiled locks of hair.</li><li><strong>Kaamashaasanaaya (कामाशासनाय)</strong>: Salutations To The one who is the chastiser and absolute ruler of desire (Kama).</li><li><strong>Kuberabandhave (कुबेरबन्धवे)</strong>: Salutations To The one who is a dear friend and relative of Kubera, the god of wealth.</li><li><strong>Kaamaatmane (कामात्मने)</strong>: Salutations To The one whose very soul is desire, and who fulfills all desires.</li><li><strong>Karnikaarapriyaaya (कर्णिकारप्रियाय)</strong>: Salutations To The one who is fond of the beautiful Karnikara flower.</li><li><strong>Kapaye (कपाए)</strong>: Salutations To The one who is the chief, or is reddish-brown in color like an ape.</li><li><strong>Kaamadevaaya (कामदेवाय)</strong>: Salutations To The one who is the divine god of love and desire.</li><li><strong>Kaamapaalaaya (कामपालाय)</strong>: Salutations To The one who is the ultimate protector and fulfiller of desires.</li><li><strong>Kaamine (कामिने)</strong>: Salutations To The one who is full of love, desire, and affection.</li><li><strong>Kaantaaya (कान्ताय)</strong>: Salutations To The one who is exceptionally beautiful, beloved, and radiant.</li><li><strong>Kritaagamaaya (कृतागमाय)</strong>: Salutations To The one who has authored the sacred scriptures and tantric texts (Agamas).</li><li><strong>Kalyaanaprakritaye (कल्याणप्रकृतये)</strong>: Salutations To The one whose intrinsic nature is auspiciousness, fortune, and well-being.</li><li><strong>Kalpaaya (कल्पाय)</strong>: Salutations To The one who is the cosmic aeon (Kalpa) and the prescribed rules.</li><li><strong>Kalpaadaye (कल्पाद्ये)</strong>: Salutations To The one who is the very beginning of every cosmic cycle.</li><li><strong>Kamalekshanaaya (कमलेक्षणाय)</strong>: Salutations To The one whose eyes are as beautiful and captivating as lotuses.</li><li><strong>Kamandaludharaaya (कमण्डलुधाराय)</strong>: Salutations To The one who carries a water pot (Kamandalu), symbolizing asceticism.</li><li><strong>Ketave (केतवे)</strong>: Salutations To The one who is a banner or a flag, a symbol of victory and sovereignty.</li><li><strong>Kaalayogine (कालयोगिने)</strong>: Salutations To The one who is a master yogi perfectly united with Time.</li><li><strong>Akalmashaaya (अकलमषाय)</strong>: Salutations To The one who is absolutely pure, sinless, and without any stain or impurity.</li><li><strong>Karanaaya (कारणाय)</strong>: Salutations To The one who is the ultimate instrument of all action and creation.</li><li><strong>Kaaranaaya (कारणाय)</strong>: Salutations To The one who is the primordial and ultimate cause of the entire universe.</li><li><strong>Kartre (कर्त्रे)</strong>: Salutations To The one who is the supreme doer and the agent of all actions.</li><li><strong>Kailaasapataye (कैलासपतये)</strong>: Salutations To The  supreme and undisputed lord of the holy Mount Kailasa.</li><li><strong>Iishvaraaya (ईश्वराय)</strong>: Salutations To The  supreme, divine, all-powerful Lord and controller of the cosmos.</li><li><strong>Kaamabhuve (कामभुवे)</strong>: Salutations To The one who is the sacred ground from which all desires are born.</li><li><strong>Kaamadaaya (कामदाय)</strong>: Salutations To The one who is the generous bestower and fulfiller of all wishes and desires.</li><li><strong>Acintyaaya (अचिन्त्याय)</strong>: Salutations To The one who is incomprehensible, unimaginable, and beyond all human thought.</li><li><strong>Kiriitine (किरीटिने)</strong>: Salutations To The one who wears a glorious, shining diadem or crown.</li><li><strong>Kaushikaaya (कौशिका)</strong>: Salutations To The one who is associated with the sage Kushika or is encased in the five sheaths (koshas).</li><li><strong>Kapilaaya (कपिलाय)</strong>: Salutations To The one who is of a reddish-brown color, and the great sage Kapila.</li><li><strong>Kushalaaya (कुशलाय)</strong>: Salutations To The one who is perpetually auspicious, skillful, and an expert in all things.</li><li><strong>Kartre (कर्त्रे)</strong>: Salutations To The one who is the ultimate agent and performer of all cosmic activities.</li><li><strong>Kumaaraaya (कुमाराय)</strong>: Salutations To The one who is the eternal youth, the divine son (like Lord Kartikeya).</li><li><strong>Kapataaya (कपटाय)</strong>: Salutations To The one who can be deceitful or illusory Salutations To The  wicked and the ignorant.</li><li><strong>Kshamaaya (क्षमाय)</strong>: Salutations To The one who is the very embodiment of supreme patience and forgiveness.</li><li><strong>Kalaadyadrishe (कलाद्यदृशे)</strong>: Salutations To The one who is the first and foremost seer of all arts and sciences.</li><li><strong>Kalaadhaaraaya (कलाधाराय)</strong>: Salutations To The one who is the fundamental support and foundation of all sixty-four arts.</li><li><strong>Kapaalakanthaaya (कपालकण्ठाय)</strong>: Salutations To The one whose throat is adorned with a garland of skulls.</li><li><strong>Kapaalabhrite (कपालभृते)</strong>: Salutations To The one who carries a skull-bowl (kapala), a symbol of ultimate renunciation.</li><li><strong>Kailaasashikharaavaasaaya (कैलासशिखरावासाय)</strong>: Salutations To The one who resides on the highest, most sacred peak of Mount Kailasa.</li><li><strong>Kuberaaya (कुबेराय)</strong>: Salutations To The one who is the lord of all wealth and treasures, Kubera.</li><li><strong>Kiirtibhuushanaaya (कीर्तिभूषणाय)</strong>: Salutations To The one whose real ornament and adornment is his immense fame and glory.</li><li><strong>Kaalajnaanine (कालज्ञानाय)</strong>: Salutations To The one who possesses the perfect knowledge of time—past, present, and future.</li><li><strong>Kalaavaasaaya (कलावासाय)</strong>: Salutations To The one who is the supreme and ultimate abode of all arts and skills.</li><li><strong>Kopitaaya (कोपिताय)</strong>: Salutations To The one who can become wrathful and intensely angry towards evil and injustice.</li><li><strong>Kaantavigrahaaya (कान्तविग्रहाय)</strong>: Salutations To The one who possesses a lovely, enchanting, and captivating physical form.</li><li><strong>Kavacine (कवचीने)</strong>: Salutations To The one who is eternally clad in an impenetrable, divine suit of armor.</li><li><strong>Kantakine (कंटकिने)</strong>: Salutations To The one who is thorny and proves to be a great obstacle to his enemies.</li><li><strong>Kaaryakovidavikramaaya (कार्यकोविद्विक्रमाय)</strong>: Salutations To The one whose extraordinary valor is guided by his expertise in all actions.</li><li><strong>Kaalabhakshaaya (कालभक्षाय)</strong>: Salutations To The one who is the ultimate devourer of time itself.</li><li><strong>Kalam (कालं)</strong>: Salutations To The one who is the sweet, gentle, and melodious sound or utterance.</li><li><strong>Kaarine (कारिणे)</strong>: Salutations To The one who is the ultimate performer and executor of all cosmic actions.</li><li><strong>Kingkiniikritavaasukaye (किंकिणीकृतवासुकये)</strong>: Salutations To The one who has the great serpent king Vasuki as his jingling anklet.</li><li><strong>Ganeshvaraaya (गणेश्वराय)</strong>: Salutations To The one who is the supreme lord of all celestial hosts and divine attendants (Ganas).</li><li><strong>Gauriishaaya (गौरीशाय)</strong>: Salutations To The one who is the beloved lord and consort of Gauri (the radiant Parvati).</li><li><strong>Giriishaaya (गिरीशाय)</strong>: Salutations To The one who is the supreme and undisputed lord of all mountains.</li><li><strong>Giribaadhakaaya (गिरिबाधकाय)</strong>: Salutations To The one who can obstruct even mountains, or who removes mountain-like obstacles for his devotees.</li><li><strong>Giridhanvane (गिरिधन्वने)</strong>: Salutations To The one whose cosmic bow is the great mountain Meru.</li><li><strong>Guhaaya (गुहाय)</strong>: Salutations To The one who resides in the secret, sacred cave of every being's heart.</li><li><strong>Goptre (गोप्तृ)</strong>: Salutations To The one who is the ultimate protector, guardian, and preserver of all creation.</li><li><strong>Gunaraashaaye (गुणराशये)</strong>: Salutations To The one who is a great, immeasurable treasure-heap of all divine virtues and noble qualities.</li><li><strong>Gunaakaraaya (गुणाकराय)</strong>: Salutations To The one who is a vast and inexhaustible mine of all excellent qualities.</li><li><strong>Gambhiiraaya (गम्भीराय)</strong>: Salutations To The one who is profoundly deep, serious, and inscrutable.</li><li><strong>Gahanaaya (गहनाय)</strong>: Salutations To The one who is impenetrable, mysterious, and unfathomable.</li><li><strong>Goptre (गोप्त्रे)</strong>: Salutations To The one who is the supreme protector and concealer of the universe.</li><li><strong>Gaayatriivallabhaaya (गायत्रीवल्लभाय)</strong>: Salutations To The one who is the beloved Lord of the sacred Gayatri mantra.</li><li><strong>Gataye (गतये)</strong>: Salutations To The one who is the ultimate goal, the final destination, and the supreme refuge for all souls.</li><li><strong>Griishmaaya (ग्रीष्माय)</strong>: Salutations To The one who is the very embodiment of the scorching, intense heat of the summer season.</li><li><strong>Grihapataye (गृहपतये)</strong>: Salutations To The one who is the divine lord of the household and the ultimate protector of the home.</li><li><strong>Guptaaya (गुप्ताय)</strong>: Salutations To The one who is hidden, secret, and concealed from all ordinary perception and understanding.</li><li><strong>Geyaaya (गेयाय)</strong>: Salutations To The one who is worthy of being praised and sung about in sacred hymns and songs.</li><li><strong>Gavyapataye (गव्यपतये)</strong>: Salutations To The one who is the lord of the senses, the master of the divine rays of light and knowledge.</li><li><strong>Agaaya (अगाय)</strong>: Salutations To The one who is immovable, unshakeable, and steadfast, like a great mountain.</li><li><strong>Ganavaahaaya (गणवाहाय)</strong>: Salutations To The one who has the divine, celestial hosts (Ganas) as his vehicle and attendants.</li><li><strong>Gunagraahine (गुणग्राहिणे)</strong>: Salutations To The one who perceives, appreciates, and graciously accepts the good qualities in all others.</li><li><strong>Gananaaya (गणनाय)</strong>: Salutations To The one who is the subject of counting and enumeration, yet is himself infinite and uncountable.</li><li><strong>Gunaraashimate (गुणराशिमते)</strong>: Salutations To The one who is possessed of a boundless multitude of all divine virtues.</li><li><strong>Agragaamine (अग्रगामिने)</strong>: Salutations To The one who always goes first, leads the way, and is the foremost of all beings.</li><li><strong>Iishvaraaya (ईश्वराय)</strong>: Salutations To The one who is the supreme Lord, the ultimate controller of the entire cosmos.</li><li><strong>Arogine (अरोगिणे)</strong>: Salutations To The one who is eternally free from all forms of disease, decay, and suffering.</li><li><strong>Khatvaanggine (खट्वांगिने)</strong>: Salutations To The one who carries a formidable club made from a human bone (Khatvanga).</li><li><strong>Gaganaalayaaya (गगनालयेय)</strong>: Salutations To The one who has the vast, infinite sky as his eternal and sacred abode.</li><li><strong>Amoghaaya (अमोघाय)</strong>: Salutations To The one who is unfailing, unerring, and whose actions and will are always fruitful and successful.</li><li><strong>Amogha phaladaaya (अमोघ फलदाय)</strong>: Salutations To The one who is the infallible and unerring bestower of the fruits of all actions.</li><li><strong>Ghantaaraaya (घण्टाराय)</strong>: Salutations To The one who is deeply fond of the sacred sound of the bell used in worship.</li><li><strong>Ghatakapriyaaya (घटकप्रियाय)</strong>: Salutations To The one who is fond of the cosmic pot, which symbolizes the womb of creation.</li><li><strong>Candraapiidaaya (चन्द्रापीडाय)</strong>: Salutations To The one who wears the moon as his radiant and glorious crown-jewel.</li><li><strong>Candramaulaye (चंद्रमौलये)</strong>: Salutations To The one whose matted crest is beautifully adorned with the crescent moon.</li><li><strong>Citraveshaaya (चित्रवेशाय)</strong>: Salutations To The one who wears wonderful, picturesque, and variegated divine attire.</li><li><strong>Cirantanaaya (चिरंतनाय)</strong>: Salutations To The one who is ancient, primeval, timeless, and eternally existent.</li><li><strong>Citteshayaaya (चित्तेशाय)</strong>: Salutations To The one who resides within the heart and consciousness (citta) of all living beings.</li><li><strong>Citrabaahave (चित्रबाहवे)</strong>: Salutations To The one who possesses wonderfully strong, beautiful, and picturesque arms.</li><li><strong>Acalaaya (अचलाय)</strong>: Salutations To The one who is immovable, unshakeable, steadfast, and eternally firm.</li><li><strong>Chinnasamshayaaya (छिन्नसंशयाय)</strong>: Salutations To The one for whom all doubts, confusions, and uncertainties have been completely and forever severed.</li><li><strong>Caturvedaaya (चतुर्वेदाय)</strong>: Salutations To The one who is the living embodiment and master of the four sacred Vedas.</li><li><strong>Caturbaahave (चतुर्बाहवे)</strong>: Salutations To The one who possesses four mighty and divine arms.</li><li><strong>Caturaaya (चतुराय)</strong>: Salutations To The one who is exceedingly clever, skillful, ingenious, and an expert in all matters.</li><li><strong>Caturapriyaaya (चतुरप्रियाय)</strong>: Salutations To The one who is fond of those who are clever, ingenious, and skillful.</li><li><strong>Caamundaajanakaaya (चामुण्डाजनकाय)</strong>: Salutations To The one who is the divine father or the ultimate origin of the fierce goddess Chamunda.</li><li><strong>Candaaya (चण्डाय)</strong>: Salutations To The one who is fierce, passionate, and intensely wrathful against all forms of evil.</li><li><strong>Calaaya (चलाय)</strong>: Salutations To The one who is ever in motion, perpetually dynamic, and constantly vibrant with life.</li><li><strong>Kshanasancalaaya (क्षणसञ्चलाय)</strong>: Salutations To The one who moves in a single instant, and is impossibly swift and fast.</li><li><strong>Acintyamahimne (अचिन्त्यमहिम्ने)</strong>: Salutations To The one whose greatness, glory, and divine majesty are beyond all human comprehension.</li><li><strong>Acintyaaya (अचिंत्याय)</strong>: Salutations To The one who is inconceivable, unimaginable, and transcends all thought.</li><li><strong>Caraacaracaritragaaya (चराचरचरित्रगाय)</strong>: Salutations To The one who is the divine singer of the tales of all moving (cara) and unmoving (acara) beings in creation.</li><li><strong>Candrasanjiivanaaya (चंद्रसंजीवनाय)</strong>: Salutations To The one who is the great reviver and rejuvenator of the moon.</li><li><strong>Citraaya (चित्राय)</strong>: Salutations To The one who is wonderful, variegated, amazing, and as picturesque as a beautiful painting.</li><li><strong>Umaacaaryaaya (उमाचार्याय)</strong>: Salutations To The one who is the revered and supreme teacher (acharya) of the goddess Uma (Parvati).</li><li><strong>Caturmukhaaya (चतुर्मुखाय)</strong>: Salutations To The one who possesses four divine faces, allowing him to see in all directions simultaneously.</li><li><strong>Ojastejodyutidharaaya (ओजस्तेजोद्युतिधराय)</strong>: Salutations To The one who holds and supports vitality, fiery energy, and brilliant radiance.</li><li><strong>Jitakaamaaya (जितकामाय)</strong>: Salutations To The one who has completely conquered all forms of desire and passion.</li><li><strong>Janapriyaaya (जनप्रियाय)</strong>: Salutations To The one who is dearly beloved by all people and beings.</li><li><strong>Ajaatashatrave (अजातशत्रवे)</strong>: Salutations To The one who has no enemy ever born against him.</li><li><strong>Ojasvine (ओजस्विने)</strong>: Salutations To The one who is full of immense vitality, energy, and life-force.</li><li><strong>Jitakaalaaya (जितकालय)</strong>: Salutations To The one who has triumphed over and conquered time itself.</li><li><strong>Jagaddhitaaya (जगद्धिताय)</strong>: Salutations To The one who always acts for the welfare and benefit of the entire world.</li><li><strong>Jamadagnaye (जमदग्नये)</strong>: Salutations To The one who is the great, fiery sage Jamadagni.</li><li><strong>Jalanidhaye (जलनिधये)</strong>: Salutations To The one who is the great treasure-house of all waters, the ocean.</li><li><strong>Jatilaaya (जटिलाय)</strong>: Salutations To The one who has matted, entangled locks of hair.</li><li><strong>Jiiviteshvaraaya (जीवितेश्वराय)</strong>: Salutations To The one who is the supreme lord and master of all life.</li><li><strong>Jananaaya (जननाय)</strong>: Salutations To The one who is the ultimate source of all birth and creation.</li><li><strong>Janajanmaadaye (जनजन्माद्ये)</strong>: Salutations To The one who is the primordial origin of all beings and their births.</li><li><strong>Arjunaaya (अर्जुनय)</strong>: Salutations To The one who is pure, white, and shining, like the hero Arjuna.</li><li><strong>Janmavijnapyaaya (जन्मविज्ञाप्याय)</strong>: Salutations To The one who can be truly known through many births of devotion.</li><li><strong>Janmaadhipaaya (जन्माधिपाय)</strong>: Salutations To The one who is the supreme sovereign and lord of all births.</li><li><strong>Jatine (जटिने)</strong>: Salutations To The one who possesses matted hair, a sign of his ascetic power.</li><li><strong>Janmajaraamrityubhayaapahaaya (जन्मजरामृत्युभयापहाय)</strong>: Salutations To The one who removes the fear of birth, old age, and death.</li><li><strong>Jiivitaantakaraaya (जीवितांतकराय)</strong>: Salutations To The one who brings about the end of life for all beings.</li><li><strong>Jyeshthaaya (ज्येष्ठाय)</strong>: Salutations To The one who is the eldest, the most senior, and the most excellent of all.</li><li><strong>Jagannaathaaya (जगन्नाथाय)</strong>: Salutations To The one who is the absolute lord and master of the entire universe.</li><li><strong>Janeshvaraaya (जनेश्वर आय)</strong>: Salutations To The one who is the supreme ruler and God of all people.</li><li><strong>Trivargasaadhanaaya (त्रिवर्गसाधनाय)</strong>: Salutations To The one who is the means to achieve the three great aims of human life (dharma, artha, kama).</li><li><strong>Taarkshyaaya (तार्क्ष्यय)</strong>: Salutations To The one who is like the mythical bird Garuda, swift and powerful.</li><li><strong>Tadgunaaya (तद्गुणाय)</strong>: Salutations To The one who possesses all of 'That' (the Ultimate Reality's) divine qualities.</li><li><strong>Tantuvardhanaaya (तन्तुवर्धनय)</strong>: Salutations To The one who weaves and expands the intricate thread of the cosmos.</li><li><strong>Tapasvine (तपस्विने)</strong>: Salutations To The one who is the greatest of all ascetics, engaged in severe penance.</li><li><strong>Taarakaaya (तारकाय)</strong>: Salutations To The one who is the great savior, the ferryman who carries souls across the ocean of existence.</li><li><strong>Taaraaya (ताराय)</strong>: Salutations To The one who is the shining star, a beacon of light and guidance.</li><li><strong>Tiivraaya (तीव्राय)</strong>: Salutations To The one who is extremely intense, fierce, and sharp.</li><li><strong>Svaatmanisamsthitaaya (स्वात्मानिसंस्थिताय)</strong>: Salutations To The one who is firmly and eternally established in his own true self.</li><li><strong>Tapanaaya (तपनाय)</strong>: Salutations To The one who blazes with heat, causing all things to become hot.</li><li><strong>Taapanaaya (तापनाय)</strong>: Salutations To The one who scorches and burns away all impurities and sins.</li><li><strong>Tushtaaya (तुष्टाय)</strong>: Salutations To The one who is perpetually satisfied, content, and pleased.</li><li><strong>Shvaanayonaye (श्वानयोनये)</strong>: Salutations To The one who is the origin of the dog, or who is served by dogs.</li><li><strong>Atandritaaya (अतन्द्रिताय)</strong>: Salutations To The one who is ever-vigilant, tireless, and eternally watchful.</li><li><strong>Uttamaanggaaya (उत्तरांगाय)</strong>: Salutations To The one who has the most excellent and supreme limbs and form.</li><li><strong>Timiraghne (तिमिरघ्ने)</strong>: Salutations To The one who is the ultimate destroyer of all darkness and ignorance.</li><li><strong>Vratine (व्रतिने)</strong>: Salutations To The one who is wholly dedicated to his sacred vows and observances.</li><li><strong>Vedaaya (वेदाय)</strong>: Salutations To The one who is the very embodiment of the sacred Vedas and all divine knowledge.</li><li><strong>Tanuunapaate (तनूनपाते)</strong>: Salutations To The one who is the 'son of himself,' self-begotten and self-created.</li><li><strong>Antarhitaaya (अन्तर्हिताय)</strong>: Salutations To The one who is concealed, hidden, and resides within all beings.</li><li><strong>Tamisraaya (तमिस्राय)</strong>: Salutations To The one who is the embodiment of darkness, the destroyer of light (for the wicked).</li><li><strong>Tejase (तेजसे)</strong>: Salutations To The one who is the very essence of all brilliance, light, and fiery energy.</li><li><strong>Tejomayaaya (तेजोमयाय)</strong>: Salutations To The one who is completely pervaded by and full of radiant light and power.</li><li><strong>Stanye (स्तन्ये)</strong>: Salutations To The one who is as nourishing and essential as mother's milk.</li><li><strong>Tarunaaya (तरुणाय)</strong>: Salutations To The one who is eternally youthful and full of vibrant, young energy.</li><li><strong>Ardhakaraaya (अर्धकाराय)</strong>: Salutations To The one who creates and holds half of the cosmic form (as Ardhanarishvara).</li><li><strong>Tigmaaya (तीग्माय)</strong>: Salutations To The one who is sharp, fierce, and intensely powerful.</li><li><strong>Tattvaaya (तत्त्वाय)</strong>: Salutations To The one who is the ultimate principle, the fundamental reality, and the absolute truth.</li><li><strong>Tattvagrihecaraaya (तत्त्वगृहेचराय)</strong>: Salutations To The one who wanders in the house of ultimate truth and reality.</li><li><strong>Tejoraashaye (तेजोराशये)</strong>: Salutations To The one who is a vast, immeasurable heap or mass of brilliant light and energy.</li><li><strong>Shatrubaanaaya (शत्रुबाणाय)</strong>: Salutations To The one who is like a deadly arrow to all his enemies.</li><li><strong>Atithaye (अतिथये)</strong>: Salutations To The one who is the unexpected guest, present everywhere without a fixed abode.</li><li><strong>Atithipriyaaya (अतिथिप्रियाय)</strong>: Salutations To The one who is deeply fond of his guests and devotees.</li><li><strong>Aatmayogashayaaya (आत्मयोगशाय)</strong>: Salutations To The one who rests in the profound state of union with his own self.</li><li><strong>Vyaanaaya (व्यानाय)</strong>: Salutations To The one who is the vital air (vayu) that pervades and circulates throughout the entire body.</li><li><strong>Tiirthadevamayaaya (तीर्थदेवमयाय)</strong>: Salutations To The one who is the embodiment of all sacred waters and holy deities.</li><li><strong>Shivaaya (शिवाय)</strong>: Salutations To The one who is supremely auspicious, benevolent, and the source of all good fortune.</li><li><strong>Sthaanadaaya (स्थानदाय)</strong>: Salutations To The one who grants a stable position, a firm abode, and a high status to his devotees.</li><li><strong>Tapanaaya (तपनाय)</strong>: Salutations To The one who is the shining and heating sun, the source of all energy.</li><li><strong>Sthaanave (स्थाणवे)</strong>: Salutations To The one who is the unmoving pillar, the fixed and eternal axis of the universe.</li><li><strong>Sthavishthaaya (स्थविष्ठाय)</strong>: Salutations To The one who is immense, vast, and the grossest of all forms.</li><li><strong>Sthaviraaya (स्थविराय)</strong>: Salutations To The one who is ancient, venerable, and eternal.</li><li><strong>Trilokeshaaya (त्रिलोकेशाय)</strong>: Salutations To The one who is the supreme ruler and lord of all three worlds.</li><li><strong>Trilokaatmane (त्रिलोकात्मने)</strong>: Salutations To The one who is the very soul and inner self of the three worlds.</li><li><strong>Trishuuline (त्रिशूलिने)</strong>: Salutations To The one who wields the mighty trident (trishula), representing the three gunas.</li><li><strong>Tridishaadhipaaya (त्रिदिशाधिपाय)</strong>: Salutations To The one who is the sovereign lord of the three directions.</li><li><strong>Trilocanaaya (त्रिलोचनाय)</strong>: Salutations To The one who possesses three eyes, representing the sun, moon, and fire.</li><li><strong>Trayiivedyaaya (त्रयीवेद्याय)</strong>: Salutations To The one who is the ultimate object of knowledge, known through the three Vedas.</li><li><strong>Trirvacah sthaaya (त्रिरवचः स्थाय)</strong>: Salutations To The one who is established in the three sacred utterances (Bhur, Bhuvah, Svah).</li><li><strong>Trivargadaaya (त्रिवर्गदाय)</strong>: Salutations To The one who is the bestower of the three aims of life (dharma, artha, kama).</li><li><strong>Duuraaya (दूराय)</strong>: Salutations To The one who is distant and far away, beyond the reach of the senses.</li><li><strong>Vaadasthaanaghnaaya (वादस्थानघ्नाय)</strong>: Salutations To The one who destroys all places of dispute and argumentation.</li><li><strong>Durdashaaya (दुर्दशाय)</strong>: Salutations To The one who brings about difficult or calamitous circumstances for the wicked.</li><li><strong>Dussahodayaaya (दुस्सहॊदयाय)</strong>: Salutations To The one whose appearance or rising is unbearable for his enemies.</li><li><strong>Paraaya (पराय)</strong>: Salutations To The one who is the supreme, the transcendent, and beyond everything.</li><li><strong>Devaaya (देवाय)</strong>: Salutations To The one who is the divine, the shining one, the celestial being.</li><li><strong>Devadevaaya (देवदेवाय)</strong>: Salutations To The one who is the god of all gods, the supreme deity.</li><li><strong>Dundubhaye (दुंदुभये)</strong>: Salutations To The one who is the celestial drum, whose sound is the cosmic vibration.</li><li><strong>Dundubhipriyaaya (दुन्दुभिप्रियाय)</strong>: Salutations To The one who is fond of the sound of the drum.</li><li><strong>Dridhaayudhadhaarine (दृढायुधधारिणे)</strong>: Salutations To The one who holds firm and mighty weapons.</li><li><strong>Dhanadaaya (धनदाय)</strong>: Salutations To The one who is the bestower of immense wealth and riches.</li><li><strong>Dakshaaya (दक्षाय)</strong>: Salutations To The one who is supremely skillful, expert, and competent in all actions.</li><li><strong>Duhsvapnanaashanaaya (दुःस्वप्ननाशनाय)</strong>: Salutations To The one who is the ultimate destroyer of all bad dreams and nightmares.</li><li><strong>Durneyaaya (दुर्ज्ञेयाय)</strong>: Salutations To The one who is difficult to know or to ascertain.</li><li><strong>Durgamaaya (दुर्गमाय)</strong>: Salutations To The one who is impassable and extremely difficult to approach or attain.</li><li><strong>Durgaaya (दुर्गाय)</strong>: Salutations To The one who is the unassailable fortress, providing absolute protection.</li><li><strong>Duraavaasaaya (दुरावासाय)</strong>: Salutations To The one who is difficult to contain or to find a dwelling for.</li><li><strong>Duraasadaaya (दुरासदाय)</strong>: Salutations To The one who is invincible and whom no enemy can ever assail.</li><li><strong>Damaaya (दमाय)</strong>: Salutations To The one who is the embodiment of self-control and restraint.</li><li><strong>Damayitre (दमयित्रे)</strong>: Salutations To The one who is the great subduer and tamer of all beings.</li><li><strong>Daantaaya (दान्ताय)</strong>: Salutations To The one who is perfectly self-restrained, calm, and subdued.</li><li><strong>Daatre (दात्रे)</strong>: Salutations To The one who is the most generous giver and donor.</li><li><strong>Daanaaya (दानाय)</strong>: Salutations To The one who is the very embodiment of charity and selfless giving.</li><li><strong>Dayaakaraaya (दयाकराय)</strong>: Salutations To The one who is the source of all compassion and mercy.</li><li><strong>Durvaasase (दुर्वाससे)</strong>: Salutations To The one who is the great sage Durvasa, known for his fiery temper.</li><li><strong>Dvijaaya (द्विजाय)</strong>: Salutations To The one who is 'twice-born,' representing a spiritual rebirth and initiation.</li><li><strong>Devakaayaaya (देवकायाय)</strong>: Salutations To The one whose body is composed of the essence of all gods.</li><li><strong>Durniktaaya (दुर्नीक्ताय)</strong>: Salutations To The one who is difficult to blame or find fault with.</li><li><strong>Durbhagodayaaya (दुर्भागोदयाय)</strong>: Salutations To The one whose rise brings misfortune Salutations To The  wicked.</li><li><strong>Dehine (देहिने)</strong>: Salutations To The one who possesses a physical body and dwells within all beings.</li><li><strong>Daahaaya (दाहाय)</strong>: Salutations To The one who is the great fire that burns and consumes all things.</li><li><strong>Daanavaaraye (दानवारये)</strong>: Salutations To The one who is the supreme enemy of the demons (Danavas).</li><li><strong>Devendraaya (देवेन्द्राय)</strong>: Salutations To The one who is the divine king of all the celestial gods, like Indra.</li><li><strong>Arimardanaaya (अरिमर्दनाय)</strong>: Salutations To The one who is the merciless crusher and destroyer of all enemies.</li><li><strong>Devaasuragurave (देवासुरगुरवे)</strong>: Salutations To The one who is the spiritual preceptor (guru) to both the gods and the demons.</li><li><strong>Devaaya (देवाय)</strong>: Salutations To The one who is the divine and radiant celestial being.</li><li><strong>Devaasuranamaskritaaya (देवासुरनमस्कृताय)</strong>: Salutations To The one who is revered and bowed to by both gods and demons alike.</li><li><strong>Devaasureshvaraaya (देवासुरेश्वराय)</strong>: Salutations To The one who is the supreme lord of both the gods and the demons.</li><li><strong>Divyaaya (दिव्याय)</strong>: Salutations To The one who is divine, celestial, heavenly, and wonderful.</li><li><strong>Devaasura maheshvaraaya (देवासुर महेश्वराय)</strong>: Salutations To The one who is the great and supreme lord of both gods and demons.</li><li><strong>Sarvadevamayaaya (सर्वदेवमयाय)</strong>: Salutations To The one who is the embodiment of all gods and contains all deities within himself.</li><li><strong>Dandaaya (दण्डाय)</strong>: Salutations To The one who is the ultimate rod of punishment for all wrongdoing.</li><li><strong>Nakshatraaya (नक्षत्राय)</strong>: Salutations To The one who is the stars and the constellations themselves.</li><li><strong>Aksharaaya (अक्षराय)</strong>: Salutations To The one who is imperishable, indestructible, and the eternal syllable (Aum).</li><li><strong>Nakshatramaalikaakeshaaya (नक्षत्रमालिकाकेशाय)</strong>: Salutations To The one whose hair is adorned with a garland of stars.</li><li><strong>Naagahaaraaya (नागहाराय)</strong>: Salutations To The one who wears a serpent as his beautiful necklace.</li><li><strong>Pinaakadhrite (पिनाकधृते)</strong>: Salutations To The one who holds the mighty bow named Pinaka.</li><li><strong>Vyayanirvahanaaya (व्ययननिर्वाहणाय)</strong>: Salutations To The one who manages and oversees all cosmic expenditure.</li><li><strong>Nyaayine (न्यायिने)</strong>: Salutations To The one who is the very embodiment of justice and logical reasoning.</li><li><strong>Nabhase (नभसे)</strong>: Salutations To The one who is the vast, ethereal sky and space.</li><li><strong>Nyaayaaya (न्यायाय)</strong>: Salutations To The one who is the ultimate principle of justice, law, and righteousness.</li><li><strong>Niranjanaaya (निरंजनाय)</strong>: Salutations To The one who is completely stainless, pure, and without any blemish.</li><li><strong>Niiraavanaaya (नीरावनाय)</strong>: Salutations To The one who is like a dense, protective forest.</li><li><strong>Ativijnaanaaya (अतिविज्ञानाय)</strong>: Salutations To The one who possesses supreme and transcendent knowledge.</li><li><strong>Narasimhanipaatanaaya (नरसिंहनिपातनाय)</strong>: Salutations To The one who brought about the fall of the fierce man-lion incarnation, Narasimha.</li><li><strong>Nandine (नन्दिने)</strong>: Salutations To The one who is full of joy and delight, and is the sacred bull, Nandi.</li><li><strong>Nandiishvaraaya (नन्दीश्वराय)</strong>: Salutations To The one who is the supreme lord and master of Nandi.</li><li><strong>Nagnaaya (नग्नाय)</strong>: Salutations To The one who is naked, stripped of all worldly illusions and coverings.</li><li><strong>Nagnavratadharaaya (नग्नव्रतधाराय)</strong>: Salutations To The one who has undertaken the sacred vow of nakedness, symbolizing utter detachment.</li><li><strong>Naraaya (नराय)</strong>: Salutations To The one who is the primordial, cosmic man or the eternal spirit.</li><li><strong>Nirmamaaya (निर्ममाय)</strong>: Salutations To The one who is completely free from the sense of 'mine' and all possessiveness.</li><li><strong>Nirahangkaaraaya (निरहंकाराय)</strong>: Salutations To The one who is utterly devoid of ego and the sense of 'I'.</li><li><strong>Nirmohaaya (निर्मोहाय)</strong>: Salutations To The one who is entirely free from all delusion and attachment.</li><li><strong>Nirupadravaaya (निरुपद्रवाय)</strong>: Salutations To The one who is free from all trouble, affliction, and calamity.</li><li><strong>Nishkantakaaya (निष्कण्टकाय)</strong>: Salutations To The one who is without any thorns or obstacles.</li><li><strong>Kritaanandaaya (कृतानंदाय)</strong>: Salutations To The one who has created and experiences divine bliss.</li><li><strong>Nirdhyaatavyaaya (निर्ध्यायाय)</strong>: Salutations To The one who is beyond all meditation, yet is the goal of meditation.</li><li><strong>Janaardanaaya (जनार्दनाय)</strong>: Salutations To The one who is the liberator of all people, the object of their adoration.</li><li><strong>Anaghaaya (अनघाय)</strong>: Salutations To The one who is completely sinless, faultless, and pure.</li><li><strong>Nishkalaaya (निष्कलाय)</strong>: Salutations To The one who is indivisible, whole, and without any parts.</li><li><strong>Nishthaaya (निष्ठाय)</strong>: Salutations To The one who is the embodiment of firm devotion and the ultimate state of being.</li><li><strong>Niilakaayaaya (नीलकायाय)</strong>: Salutations To The one who has a body of a beautiful, dark-blue hue.</li><li><strong>Niraamayaaya (निरामयाय)</strong>: Salutations To The one who is completely free from all disease and ailments.</li><li><strong>Aniruddhaaya (अनिरुद्धाय)</strong>: Salutations To The one who is unobstructed, unstoppable, and can never be confined.</li><li><strong>Anaadyantaaya (अनाद्यंताय)</strong>: Salutations To The one who is without any beginning (anadi) or any end (anta).</li><li><strong>Naikaatmane (नैकात्मने)</strong>: Salutations To The one who is not a single self, but manifests as innumerable souls.</li><li><strong>Naikakarmakrite (नैकाकर्मकृते)</strong>: Salutations To The one who is the performer of countless and varied actions.</li><li><strong>Nagaretase (नागरेतसे)</strong>: Salutations To The one whose seed is the mountains, or who resides in the city of Kashi.</li><li><strong>Nakhine (नखिने)</strong>: Salutations To The one who is endowed with sharp claws or nails.</li><li><strong>Nandine (नन्दीने)</strong>: Salutations To The one who brings joy and is the sacred bull Nandi.</li><li><strong>Aanandavanavardhanaaya (आनंदवनवर्धनाय)</strong>: Salutations To The one who increases the bliss of the forest of liberation (Kashi).</li><li><strong>Yogaaya (योगाय)</strong>: Salutations To The one who is the very embodiment of divine union and spiritual discipline.</li><li><strong>Viraagine (विरागीने)</strong>: Salutations To The one who is completely dispassionate and free from all attachments.</li><li><strong>Vairaagine (वैरागिने)</strong>: Salutations To The one who is the supreme ascetic, filled with profound renunciation.</li><li><strong>Tyaagine (त्यागिने)</strong>: Salutations To The one who is the ultimate renunciant, having given up everything.</li><li><strong>Gauriivaraangganaaya (गौरीवरंगणाय)</strong>: Salutations To The one who has the beautiful Gauri (Parvati) as his beloved consort.</li><li><strong>Kambukanthaaya (कम्बुकण्ठाय)</strong>: Salutations To The one who has a beautiful, shell-shaped neck with three lines.</li><li><strong>Grihasthaaya (गृहस्थाय)</strong>: Salutations To The one who is the perfect householder, living in the world yet detached.</li><li><strong>Ugraaya (उग्राय)</strong>: Salutations To The one who is fearsome, ferocious, and terrible to his enemies.</li><li><strong>Candaaya (चण्डाय)</strong>: Salutations To The one who is fierce, passionate, and wrathful towards evil.</li><li><strong>Akhandabhrite (अखण्डभृते)</strong>: Salutations To The one who upholds the entire, unbroken cosmos.</li><li><strong>Antakaaya (अन्तकाय)</strong>: Salutations To The one who is the ultimate bringer of death and the end of all things.</li><li><strong>Taandavaadambararucaye (ताण्डवाडम्बररुचये)</strong>: Salutations To The one who delights in the cosmic dance of creation and destruction (Tandava).</li><li><strong>Rurumandalamanditaaya (रुरुमण्डलमण्डिताय)</strong>: Salutations To The one who is adorned with a circle of fierce Ruru demons or deerskins.</li><li><strong>Parameshvaraaya (परमेश्वराय)</strong>: Salutations To The one who is the supreme, ultimate, and transcendent Lord.</li><li><strong>Pashupataye (पशुपतये)</strong>: Salutations To The one who is the divine lord and master of all living beings (pashus).</li><li><strong>Pinaakine (पिनाकिने)</strong>: Salutations To The one who wields the mighty celestial bow known as Pinaka.</li><li><strong>Purashaasanaaya (पुरशासनाय)</strong>: Salutations To The one who is the great ruler and chastiser of the three celestial cities (Tripura).</li><li><strong>Puraatsuutaaya (पुरास्तुताय)</strong>: Salutations To The one who is praised and celebrated in the ancient Puranas.</li><li><strong>Devakiiraaya (देवकीराय)</strong>: Salutations To The one who is the divine creator of all the gods.</li><li><strong>Parameshthine (परमेष्ठिने)</strong>: Salutations To The one who is established in the highest and most supreme position.</li><li><strong>Paraayanaaya (परायणाय)</strong>: Salutations To The one who is the ultimate and final refuge for all souls.</li><li><strong>Pancavimshatitatvasthaaya (पञ्चविंशतितत्त्वस्थाय)</strong>: Salutations To The one who resides in the twenty-five fundamental principles (tattvas) of creation.</li><li><strong>Pancajantave (पञ्चजन्तवे)</strong>: Salutations To The one who is the five great elements that constitute all beings.</li><li><strong>Prabhanjanaaya (प्रभंजनाय)</strong>: Salutations To The one who is the great, shattering storm that destroys all obstacles.</li><li><strong>Maskarine (मस्करिणे)</strong>: Salutations To The one who is a wandering ascetic holding a bamboo staff (maskara).</li><li><strong>Parabrahmane (परब्रह्मणे)</strong>: Salutations To The one who is the supreme, transcendent, absolute reality, the Parabrahman.</li><li><strong>Paarijaataaya (पारिजाताय)</strong>: Salutations To The one who is the celestial, wish-fulfilling Parijata tree.</li><li><strong>Paraatparaaya (परात्पराय)</strong>: Salutations To The one who is beyond the beyond, higher than the highest.</li><li><strong>Pratishthitaaya (प्रतिष्ठिताय)</strong>: Salutations To The one who is firmly established and the foundation of all existence.</li><li><strong>Pramaanajnaaya (प्रमाणज्ञाय)</strong>: Salutations To The one who is the ultimate knower of all valid means of knowledge (pramanas).</li><li><strong>Pramaanaaya (प्रमाणाय)</strong>: Salutations To The one who is the ultimate authority and the standard of all proof.</li><li><strong>Paramaarthadaaya (परमार्थदाय)</strong>: Salutations To The one who is the bestower of the highest and ultimate truth.</li><li><strong>Pancabrahmane (पञ्चब्रह्मणे)</strong>: Salutations To The one who is the five-faced Brahman, representing the five cosmic functions.</li><li><strong>Satpataye (सत्पतये)</strong>: Salutations To The one who is the lord and protector of the virtuous and the good.</li><li><strong>Paramaatmane (परमात्मने)</strong>: Salutations To The one who is the supreme, universal self, the Paramatma.</li><li><strong>Paraayanaaya (परायणाय)</strong>: Salutations To The one who is the supreme goal and the ultimate sanctuary.</li><li><strong>Pinaakapaanaye (पिनाकपाणये)</strong>: Salutations To The one who holds the great bow Pinaka in his hand.</li><li><strong>Praamshave (प्राम्शवे)</strong>: Salutations To The one who is of a tall, lofty, and imposing stature.</li><li><strong>Pratyayaaya (प्रत्ययाय)</strong>: Salutations To The one who is the embodiment of firm faith, conviction, and trust.</li><li><strong>Paraviiraghne (परवीरघ्ने)</strong>: Salutations To The one who is the valiant slayer of enemy heroes.</li><li><strong>Prabhaakaraaya (प्रभाकराय)</strong>: Salutations To The one who is the radiant source of all light, like the sun.</li><li><strong>Pratyakshaaya (प्रत्यक्षाय)</strong>: Salutations To The one who is directly perceptible and visible to his devotees.</li><li><strong>Pranavaaya (प्रणवाय)</strong>: Salutations To The one who is the sacred, primordial sound of the cosmos, 'Aum'.</li><li><strong>Puranjayaaya (पुरंजयाय)</strong>: Salutations To The one who is the great conqueror of all cities and fortresses.</li><li><strong>Pavitrapaanaye (पवित्रपाणये)</strong>: Salutations To The one whose hands are supremely pure and sanctifying.</li><li><strong>Paapaaraye (पापाराये)</strong>: Salutations To The one who is the ultimate enemy of all sin and wickedness.</li><li><strong>Pratyayaacirshe (प्रत्यायाचिरशे)</strong>: Salutations To The one who is the pinnacle and crown of all faith.</li><li><strong>Apaam nidhaye (अपाम निधये)</strong>: Salutations To The one who is the great treasure-house and receptacle of all waters.</li><li><strong>Pulastyaaya (पुलस्त्याय)</strong>: Salutations To The one who is the great, ancient sage Pulastya.</li><li><strong>Pulahaaya (पुलहाय)</strong>: Salutations To The one who is the great sage Pulaha, one of the creators of mankind.</li><li><strong>Agastyaaya (अगस्त्याय)</strong>: Salutations To The one who is the revered and powerful sage Agastya.</li><li><strong>Puruhuutaaya (पुरुषूताय)</strong>: Salutations To The one who is invoked and called upon by many.</li><li><strong>Purushtutaaya (पुरुषस्तुताय)</strong>: Salutations To The one who is praised and extolled by many devotees.</li><li><strong>Padmaakaraaya (पद्माकराया)</strong>: Salutations To The one who is the source of all lotuses, or whose hands are like lotuses.</li><li><strong>Parasmaijyotishe (परस्मैज्योतिषे)</strong>: Salutations To The one who is the supreme, transcendent, and ultimate light.</li><li><strong>Paraaparaphalapradaaya (परापरफलप्रदाय)</strong>: Salutations To The one who bestows the fruits of both higher and lower actions.</li><li><strong>Paraavarajnaaya (परावरज्ञाय)</strong>: Salutations To The one who knows both the supreme (para) and the manifest (avara).</li><li><strong>Paradaaya (परदाय)</strong>: Salutations To The one who bestows the ultimate liberation or the highest state.</li><li><strong>Parashatrave (परशत्रवे)</strong>: Salutations To The one who is a formidable enemy to all opposing forces.</li><li><strong>Parasmaipadaaya (परस्मैपदाय)</strong>: Salutations To The one who is the supreme word, the ultimate state.</li><li><strong>Puurnaaya (पूर्णाय)</strong>: Salutations To The one who is complete, full, whole, and perfect.</li><li><strong>Puurayitre (पूरयित्रे)</strong>: Salutations To The one who fulfills all desires and completes all things.</li><li><strong>Punyaaya (पुण्याय)</strong>: Salutations To The one who is the very embodiment of merit, virtue, and sacredness.</li><li><strong>Punyashravanakiirtanaaya (पुण्यश्रवणकीर्तनाय)</strong>: Salutations To The one whose glory is meritorious to hear and chant.</li><li><strong>Purandaraaya (पुरंदराय)</strong>: Salutations To The one who is the destroyer of enemy cities, like Indra.</li><li><strong>Punyakiirtaye (पुण्यकीर्तये)</strong>: Salutations To The one whose fame and glory are supremely pure and sacred.</li><li><strong>Pramaadine (प्रमादिने)</strong>: Salutations To The one who can cause intoxication or delusion in the unrighteous.</li><li><strong>Paapanaashanaaya (पापनाशनाय)</strong>: Salutations To The one who is the ultimate destroyer of all sins.</li><li><strong>Parashiilaaya (परशीलाय)</strong>: Salutations To The one who possesses the most supreme and excellent character.</li><li><strong>Paragunaaya (परगुणाया)</strong>: Salutations To The one who possesses transcendent and supreme qualities.</li><li><strong>Praaduraagaaya (प्रादुरागाय)</strong>: Salutations To The one who appears with intense passion and love.</li><li><strong>Purandaraaya (पुरन्दराय)</strong>: Salutations To The one who is the conqueror of strongholds.</li><li><strong>Paraarthavyaktaye (परार्थव्यक्तये)</strong>: Salutations To The one whose manifestation is for the ultimate benefit of others.</li><li><strong>Prabhavaaya (प्रभवाय)</strong>: Salutations To The one who is the glorious origin and source of all creation.</li><li><strong>Purushaaya (पुरुषाय)</strong>: Salutations To The one who is the primordial cosmic person, the indwelling spirit.</li><li><strong>Purujaaya (पुरुजाय)</strong>: Salutations To The one who is born in many forms and is multi-faceted.</li><li><strong>Pitre (पित्रै)</strong>: Salutations To The one who is the divine father of the entire universe.</li><li><strong>Pinggalaaya (पिंगलाय)</strong>: Salutations To The one who is of a tawny, golden-brown hue.</li><li><strong>Paavanaaya (पावनाय)</strong>: Salutations To The one who is the ultimate purifier and sanctifier of all things.</li><li><strong>Plakshaaya (प्लक्षाय)</strong>: Salutations To The one who is the sacred fig tree, the source of creation.</li><li><strong>Atalaaya (अतलाय)</strong>: Salutations To The one who is the bottomless, one of the seven netherworlds.</li><li><strong>Puushadantaghne (पूषदन्तघ्ने)</strong>: Salutations To The one who knocked out the teeth of the god Pushan.</li><li><strong>Paramaarthagurave (परमार्थगुरवे)</strong>: Salutations To The one who is the supreme spiritual master of the ultimate truth.</li><li><strong>Priitaye (प्रीतये)</strong>: Salutations To The one who is the embodiment of love, joy, and affection.</li><li><strong>Priitamate (प्रीतमते)</strong>: Salutations To The one who has a loving and benevolent disposition.</li><li><strong>Puraatanaaya (पुरातनाय)</strong>: Salutations To The one who is the most ancient, primeval, and the oldest of all.</li><li><strong>Paraasharaaya (पराशराय)</strong>: Salutations To The one who is the 'destroyer of the enemy,' and the great sage Parashara.</li><li><strong>Padmagarbhaaya (पद्मगर्भाय)</strong>: Salutations To The one who contains the lotus of creation within himself.</li><li><strong>Paraaya (पराय)</strong>: Salutations To The one who is the supreme, transcendent, and ultimate reality.</li><li><strong>Parapuranjayaaya (परपुरंजयाय)</strong>: Salutations To The one who is the great conqueror of the cities of his enemies.</li><li><strong>Upaplavaaya (उपप्लवाय)</strong>: Salutations To The one who causes afflictions and calamities for the unrighteous.</li><li><strong>Ubhayaakaraaya (उभयाकराय)</strong>: Salutations To The one who is the creator of both—the manifest and the unmanifest.</li><li><strong>Paramaarthaikapanditaaya (परमार्थैकपण्डिताय)</strong>: Salutations To The one who is the sole and supreme scholar of the ultimate truth.</li><li><strong>Maheshvaraaya (महेश्वराय)</strong>: Salutations To The one who is the Great God, the supreme Lord of all.</li><li><strong>Mahaadevaaya (महादेवाय)</strong>: Salutations To The one who is the Great Deity, the highest of all gods.</li><li><strong>Mudgalaaya (मुद्गलाय)</strong>: Salutations To The one who wields a mace or is the sage Mudgala.</li><li><strong>Madhuraaya (मधुराय)</strong>: Salutations To The one who is exceedingly sweet, charming, and delightful.</li><li><strong>Mridave (मृडवे)</strong>: Salutations To The one who is gentle, soft, and compassionate.</li><li><strong>Mattaashayaaya (मत्ताशयाय)</strong>: Salutations To The one whose thoughts are intoxicated with divine bliss.</li><li><strong>Mahaayogine (महायोगिने)</strong>: Salutations To The one who is the greatest and most supreme of all yogis.</li><li><strong>Mahaakarmane (महाकर्मणे)</strong>: Salutations To The one who performs great and mighty cosmic actions.</li><li><strong>Mahaushadhaaya (महाऔषधाय)</strong>: Salutations To The one who is the great, universal medicine that cures all ills.</li><li><strong>Maharshaye (महर्षये)</strong>: Salutations To The one who is the greatest of all the divine seers and sages.</li><li><strong>Kapilaacaaryaaya (कपिलाचार्याय)</strong>: Salutations To The one who is the great teacher and sage, Kapila.</li><li><strong>Mrigadhaamne (मृगधाम्ने)</strong>: Salutations To The one who has the deer as his abode or symbol.</li><li><strong>Mahaalayaaya (महालय)</strong>: Salutations To The one who is the great, supreme, and ultimate abode of the universe.</li><li><strong>Mahaanidhaye (महानिधये)</strong>: Salutations To The one who is the great, inexhaustible treasure-house of all things.</li><li><strong>Mahaabhuutaye (महाभूतये)</strong>: Salutations To The one who is the embodiment of great existence and divine glory.</li><li><strong>Mahaaniitaye (महानितये)</strong>: Salutations To The one who is the embodiment of the highest and most supreme justice.</li><li><strong>Mahaamataye (महामतये)</strong>: Salutations To The one who possesses a great, vast, and supreme intellect.</li><li><strong>Mahaagrahaaya (महाग्रहाय)</strong>: Salutations To The one who is the great seizer, the most powerful of all cosmic influences.</li><li><strong>Mahaagantre (महागन्त्रे)</strong>: Salutations To The one who is the great traveler, pervading all of space.</li><li><strong>Mahaabhuutaaya (महाभूताय)</strong>: Salutations To The one who is the great element, the very essence of all existence.</li><li><strong>Amritaaya (अमृताय)</strong>: Salutations To The one who is the divine nectar of immortality, eternal and undying.</li><li><strong>Yamaaya (यमाय)</strong>: Salutations To The one who is the lord of death and the great controller (Yama).</li><li><strong>Amritaamshave (अमृतांशवे)</strong>: Salutations To The one whose rays are like life-giving nectar.</li><li><strong>Amritavapushe (अमृतवपुषे)</strong>: Salutations To The one whose very body is made of the immortal nectar.</li><li><strong>Mariicaye (मरीचये)</strong>: Salutations To The one who is a ray of light, and the great sage Marichi.</li><li><strong>Mohajaalaghne (मोहजालघ्ने)</strong>: Salutations To The one who is the absolute destroyer of the web of delusion and attachment.</li><li><strong>Mahaatapase (महातपसे)</strong>: Salutations To The one who performs the most severe and supreme austerities.</li><li><strong>Mahaakaayaaya (महाकायाय)</strong>: Salutations To The one who possesses a colossal, immense, and great body.</li><li><strong>Mrigabaanaarpanaaya (मृगबाणार्पणाय)</strong>: Salutations To The one who received an arrow meant for a deer.</li><li><strong>Khalaaya (खलाय)</strong>: Salutations To The one who is the threshing floor, separating righteousness from wickedness.</li><li><strong>Mahaabalaaya (महाबलाय)</strong>: Salutations To The one who possesses immense, immeasurable, and supreme strength.</li><li><strong>Mahiipaataaya (महीपाताय)</strong>: Salutations To The one who is the great protector and ruler of the earth.</li><li><strong>Mahaayogine (महायोगिने)</strong>: Salutations To The one who is the supreme master of all forms of yoga.</li><li><strong>Mahaamanase (महामनसे)</strong>: Salutations To The one who possesses a great, vast, and cosmic mind.</li><li><strong>Mahaamaayaaya (महामायाय)</strong>: Salutations To The one who wields the great, cosmic power of illusion (Maya).</li><li><strong>Mahaashaantaaya (महाशान्ताय)</strong>: Salutations To The one who is eternally and supremely peaceful and tranquil.</li><li><strong>Mataye (मताय)</strong>: Salutations To The one who is the very embodiment of thought, wisdom, and intellect.</li><li><strong>Naadaaya (नादाय)</strong>: Salutations To The one who is the primordial, cosmic sound and vibration.</li><li><strong>Mahotsavaaya (महोत्सवाय)</strong>: Salutations To The one who is the great cosmic festival and a source of eternal celebration.</li><li><strong>Maatsaryavide (मात्सर्यविदे)</strong>: Salutations To The one who understands and is beyond all jealousy and envy.</li><li><strong>Mahaaviiryaaya (महावीर्याय)</strong>: Salutations To The one who possesses supreme, immeasurable valor and virility.</li><li><strong>Mahaashaktaye (महाशक्तये)</strong>: Salutations To The one who possesses great, infinite, and supreme power.</li><li><strong>Mahaadyutaye (महाद्युतये)</strong>: Salutations To The one who possesses a great, brilliant, and supreme radiance.</li><li><strong>Unmattakiirtikrite (उन्मत्तकीर्तिकृते)</strong>: Salutations To The one whose fame is so great it appears ecstatic or mad.</li><li><strong>Mattaaya (मत्ताय)</strong>: Salutations To The one who is intoxicated with divine bliss and cosmic energy.</li><li><strong>Maghavate (मघवते)</strong>: Salutations To The one who is generous and bountiful, like Indra (Maghavan).</li><li><strong>Amitaaya (अमिताय)</strong>: Salutations To The one who is immeasurable, boundless, and infinite.</li><li><strong>Mataye (मताय)</strong>: Salutations To The one who is supreme intelligence and guiding thought.</li><li><strong>Mahaabhogaaya (महाभोगाय)</strong>: Salutations To The one who is the great enjoyer of the cosmic manifestation.</li><li><strong>Amritaaya (अमृताय)</strong>: Salutations To The one who is immortal and the divine nectar of eternity.</li><li><strong>Mantraaya (मन्त्राय)</strong>: Salutations To The one who is the sacred formula, the embodiment of the divine mantra.</li><li><strong>Manggalaaya (मङ्गलाय)</strong>: Salutations To The one who is the very essence of all that is auspicious and fortunate.</li><li><strong>Manggalapriyaaya (मङ्गलप्रियाय)</strong>: Salutations To The one who is fond of all things auspicious and benevolent.</li><li><strong>Amoghadandaaya (अमोघदण्डाय)</strong>: Salutations To The one whose punishment is unerring and infallible.</li><li><strong>Madhyasthaaya (मध्यस्थाय)</strong>: Salutations To The one who is impartial, neutral, and stands in the center of all things.</li><li><strong>Maheshaaya (महेशाय)</strong>: Salutations To The one who is the Great Lord, the supreme sovereign.</li><li><strong>Amoghavikramaaya (अमोघविक्रमाय)</strong>: Salutations To The one whose valor and prowess are unfailing and invincible.</li><li><strong>Ameyaaya (अमेयाय)</strong>: Salutations To The one who is immeasurable, unknowable, and beyond all estimation.</li><li><strong>Arishtamathanaaya (अरिष्टमथनाय)</strong>: Salutations To The one who is the great crusher and destroyer of all calamities and misfortunes.</li><li><strong>Mukundaaya (मुकुंदाय)</strong>: Salutations To The one who is the giver of liberation (mukti) and ultimate freedom.</li><li><strong>Sarvapaapaghne (सर्वपापघ्ने)</strong>: Salutations To The one who is the supreme destroyer of all sins and their effects.</li><li><strong>Maataamahaaya (मातामहाया)</strong>: Salutations To The one who is the great maternal grandfather of the cosmos.</li><li><strong>Maatarishvane (मातरिश्वने)</strong>: Salutations To The  an who is the cosmic breath, moving in the celestial space like the wind god Matarishvan.</li><li><strong>Manipuuraaya (मणिपूराय)</strong>: Salutations To The one who resides in the Manipura chakra, the city of jewels in the navel.</li><li><strong>Mahaashaayaaya (महाशयाय)</strong>: Salutations To The one who has a great, noble, and magnanimous mind.</li><li><strong>Madaghne (मदघ्ने)</strong>: Salutations To The one who is the destroyer of all arrogance, pride, and intoxication.</li><li><strong>Mahaagarbhaaya (महागर्भाय)</strong>: Salutations To The one who contains the great cosmic womb of the universe within himself.</li><li><strong>Mahaakalpaaya (महाकल्पाय)</strong>: Salutations To The one who is the great cosmic aeon, the measure of universal time.</li><li><strong>Mahaadhanushe (महाधनुषे)</strong>: Salutations To The one who wields a great and mighty celestial bow.</li><li><strong>Manase (मनसे)</strong>: Salutations To The one who is the cosmic mind, the source of all thought.</li><li><strong>Manomayaaya (मनोमायाय)</strong>: Salutations To The one who is formed of pure consciousness and whose nature is of the mind.</li><li><strong>Maanine (मानिने)</strong>: Salutations To The one who is honored, respected, and worthy of all reverence.</li><li><strong>Merupadyaaya (मेरुपद्याय)</strong>: Salutations To The one whose divine feet are the sacred Mount Meru.</li><li><strong>Mridaaya (मृडाय)</strong>: Salutations To The one who is gracious, merciful, and compassionate to his devotees.</li><li><strong>Manave (मानवे)</strong>: Salutations To The one who is the primordial man, the father of humanity (Manu).</li><li><strong>Mahaashobhaaya (महाशोभाय)</strong>: Salutations To The one who possesses great, supreme, and dazzling beauty.</li><li><strong>Mahaajnaanine (महाज्ञानिने)</strong>: Salutations To The one who possesses great, profound, and supreme wisdom.</li><li><strong>Mahaakaalaaya (महाकालाय)</strong>: Salutations To The one who is the Great Time, the destroyer of all things.</li><li><strong>Kalipriyaaya (कलिप्रियाय)</strong>: Salutations To The one who is fond of the age of Kali, or of quarrels.</li><li><strong>Mahaavatave (महावटवे)</strong>: Salutations To The one who is the great banyan tree, the axis of the cosmos.</li><li><strong>Mahaatyaagine (महात्यागिने)</strong>: Salutations To The one who is the greatest of all renunciants.</li><li><strong>Mahaakoshaaya (महाकोषाय)</strong>: Salutations To The one who is the great treasure or sheath that envelops reality.</li><li><strong>Mahaagataye (महागतये)</strong>: Salutations To The one who is the supreme and ultimate goal of existence.</li><li><strong>Shikhandine (शिखण्डिने)</strong>: Salutations To The one who wears a peacock feather in his crest.</li><li><strong>Kavacine (कवचिने)</strong>: Salutations To The one who is always protected by divine armor.</li><li><strong>Shuuline (शूलिने)</strong>: Salutations To The one who wields the mighty trident (shula).</li><li><strong>Jatine (जटिने)</strong>: Salutations To The one who has matted locks of hair, a sign of his ascetic power.</li><li><strong>Mundine (मुंडिने)</strong>: Salutations To The one who has a shaven head, symbolizing complete renunciation.</li><li><strong>Kundaline (कुण्डलिने)</strong>: Salutations To The one who wears earrings, or who is the coiled serpent power (Kundalini).</li><li><strong>Meghamaaline (मेघमालिने)</strong>: Salutations To The one who wears a garland of clouds.</li><li><strong>Cakrakhadgine (चक्रखड्गिने)</strong>: Salutations To The one who is armed with a discus (chakra) and a sword (khadga).</li><li><strong>Maaline (मालिने)</strong>: Salutations To The one who wears a divine garland.</li><li><strong>Maayaaya (मायाय)</strong>: Salutations To The one who is the master of illusion and the cosmic creative force.</li><li><strong>Mahaamanaye (महामनये)</strong>: Salutations To The one who is the great, precious gem of existence.</li><li><strong>Maheshvaasaaya (महेश्वसाय)</strong>: Salutations To The one who is the great archer with a mighty bow.</li><li><strong>Mahaanandaaya (महानन्दाय)</strong>: Salutations To The one who is the embodiment of supreme, unending bliss.</li><li><strong>Mahaacaaraaya (महाचार्याय)</strong>: Salutations To The one who follows the greatest and most noble code of conduct.</li><li><strong>Mahaabhujaaya (महाभुजाय)</strong>: Salutations To The one who possesses great and mighty arms.</li><li><strong>Makhakartre (मखकर्त्रे)</strong>: Salutations To The one who is the ultimate performer of all sacred sacrifices (makha).</li><li><strong>Makhadhvamsine (मखध्वंसिने)</strong>: Salutations To The one who is the great destroyer of sacrifices when they are performed with arrogance.</li><li><strong>Madhuraaya (मधुराय)</strong>: Salutations To The one who is delightfully sweet and charming.</li><li><strong>Maghavatpriyaaya (मघवतप्रियाय)</strong>: Salutations To The one who is dear Salutations To The  generous and bountiful Indra (Maghavan).</li><li><strong>Brahmasrishtaye (ब्रह्मसृष्टये)</strong>: Salutations To The one who is the creative power of Brahma.</li><li><strong>Brahmaviiryaaya (ब्रह्मवीर्याय)</strong>: Salutations To The one who possesses the divine potency and valor of Brahman.</li><li><strong>Baanahastaaya (बाणहस्ताय)</strong>: Salutations To The one who holds powerful arrows in his hand.</li><li><strong>Acalaaya (अचलाय)</strong>: Salutations To The one who is unmoving, firm, and eternally stable.</li><li><strong>Baline (बलिने)</strong>: Salutations To The one who is supremely powerful, mighty, and strong.</li><li><strong>Kiiraruupaaya (कीररूपाय)</strong>: Salutations To The one who can take the form of a parrot.</li><li><strong>Calaaya (चलाय)</strong>: Salutations To The one who is ever-moving and dynamic.</li><li><strong>Unmaadine (उन्मादिने)</strong>: Salutations To The one who is divinely intoxicated, in a state of ecstatic madness.</li><li><strong>Brahmanyaaya (ब्रह्मन्याय)</strong>: Salutations To The one who is devoted Salutations To The  pursuit of spiritual knowledge and Salutations To The  Brahmins.</li><li><strong>Brahmavarcasaaya (ब्रह्मवर्चसाय)</strong>: Salutations To The one who possesses the divine splendor and spiritual effulgence of Brahman.</li><li><strong>Bahuruupaaya (बहुरूपाया)</strong>: Salutations To The one who manifests in countless, manifold forms.</li><li><strong>Bahumayaaya (बहुमायाय)</strong>: Salutations To The one who is pervaded by multiplicity and has become many.</li><li><strong>Brahmavishnushivaatmakaaya (ब्रह्मविष्णुशिवात्मकाय)</strong>: Salutations To The one who is the single soul of the divine trinity: Brahma, Vishnu, and Shiva.</li><li><strong>Brahmagarbhaaya (ब्रह्मगर्भाय)</strong>: Salutations To The one who contains Brahma, the creator, within his womb.</li><li><strong>Aksharaaya (अक्षराय)</strong>: Salutations To The one who is eternal, imperishable, and indestructible.</li><li><strong>Dambhaaya (दम्भाय)</strong>: Salutations To The one who can be proud or deceitful to test his devotees or punish the wicked.</li><li><strong>Brahmajyotishe (ब्रह्मज्योतिषे)</strong>: Salutations To The one who is the divine, effulgent light of the absolute Brahman.</li><li><strong>Brihaspataye (बृहस्पतये)</strong>: Salutations To The one who is the great lord of prayer, the preceptor of the gods (Brihaspati).</li><li><strong>Biijabuddhaye (बीजबुद्धये)</strong>: Salutations To The one whose intelligence is the seed of all creation.</li><li><strong>Brahmacaarine (ब्रह्मचारिणे)</strong>: Salutations To The one who is the perfect celibate, walking in the path of Brahman.</li><li><strong>Braahmanaaya (ब्राह्मणाय)</strong>: Salutations To The one who is the embodiment of the priestly class, the Brahmin.</li><li><strong>Braahmanapriyaaya (ब्राह्मणप्रियाय)</strong>: Salutations To The one who is deeply fond of the wise and learned Brahmins.</li><li><strong>Yugaadikrite (युगादिकृते)</strong>: Salutations To The one who is the creator of the beginning of all cosmic ages (yugas).</li><li><strong>Yugaavartaaya (युगावर्ताय)</strong>: Salutations To The one who causes the cosmic ages to revolve in their cycles.</li><li><strong>Yugaadhyakshaaya (युगाध्यक्षाय)</strong>: Salutations To The one who is the supreme presiding deity of all the cosmic ages.</li><li><strong>Yugaapaghne (युगापघ्ने)</strong>: Salutations To The one who is the destroyer and dissolver of the cosmic ages.</li><li><strong>Yajnaaya (यज्ञाय)</strong>: Salutations To The one who is the sacred sacrificial ritual (yajna) itself.</li><li><strong>Yajnapataye (यज्ञपतये)</strong>: Salutations To The one who is the divine lord and protector of all sacrifices.</li><li><strong>Yajvane (यज्वने)</strong>: Salutations To The one who is the sacrificer, the one who performs the sacred ritual.</li><li><strong>Yajnaanggaaya (यज्ञांगाय)</strong>: Salutations To The one whose limbs are the very components of the sacrifice.</li><li><strong>Yajnavaahanaaya (यज्ञवाहनाय)</strong>: Salutations To The one who has the sacrifice as his divine vehicle.</li><li><strong>Yogaacaaryaaya (योगाचार्याय)</strong>: Salutations To The one who is the supreme preceptor and master of yoga.</li><li><strong>Yogigamyaaya (योगिगम्याय)</strong>: Salutations To The one who can only be reached and attained by true yogis.</li><li><strong>Yogine (योगिने)</strong>: Salutations To The one who is the perfect and supreme master of yoga.</li><li><strong>Yogyaaya (योग्याय)</strong>: Salutations To The  an who is worthy, fit, and deserving of all worship and union.</li><li><strong>Yogavide (योगविदे)</strong>: Salutations To The one who is the ultimate knower of the science of yoga.</li><li><strong>Yogaanggaaya (योगांगाय)</strong>: Salutations To The one whose body is composed of the limbs of yoga.</li><li><strong>Yogahaaraanggaaya (योगहाराङ्गाय)</strong>: Salutations To The one who is adorned with the essence of yoga.</li><li><strong>Yakshaaya (यक्षाय)</strong>: Salutations To The one who is a divine nature spirit (Yaksha), a guardian of treasures.</li><li><strong>Yuktimayaaya (युक्तिमयाय)</strong>: Salutations To The one who is the embodiment of all reason, logic, and skillful planning.</li><li><strong>Yamaaya (यमाय)</strong>: Salutations To The one who is the great controller and the lord of death.</li><li><strong>Raudraaya (रौद्राय)</strong>: Salutations To The one who is of a fierce, wrathful, and terrible form.</li><li><strong>Raudrarshaye (रौद्रऋषये)</strong>: Salutations To The one who is the fierce and powerful divine sage.</li><li><strong>Raahave (राहवे)</strong>: Salutations To The one who is the celestial being Rahu, who causes eclipses.</li><li><strong>Ratiratnaaya (रति रत्नाय)</strong>: Salutations To The one who is the most precious jewel of all delights and pleasures.</li><li><strong>Ranapriyaaya (रणप्रियाय)</strong>: Salutations To The one who is fond of battle and loves a good fight.</li><li><strong>Lokabandhave (लोकबन्धवे)</strong>: Salutations To The one who is a friend and kinsman Salutations To The  entire world.</li><li><strong>Lokanaathaaya (लोकनाथाय)</strong>: Salutations To The one who is the supreme lord and protector of all the worlds.</li><li><strong>Lakshayajnaaya (लक्षयज्ञाय)</strong>: Salutations To The one who is the aim and object of a hundred thousand sacrifices.</li><li><strong>Lakshanaaya (लक्षणाय)</strong>: Salutations To The one who is the embodiment of all auspicious marks and characteristics.</li><li><strong>Lolamaayaaya (लोलमायाय)</strong>: Salutations To The one whose illusory power (Maya) is ever-flickering and playful.</li><li><strong>Lokakartre (लोककर्त्रे)</strong>: Salutations To The one who is the creator and maker of all the worlds.</li><li><strong>Lokyaaya (लोक्याय)</strong>: Salutations To The one who is renowned throughout all the worlds.</li><li><strong>Lolaaya (लोलाय)</strong>: Salutations To The one who is restless, ever-desirous, and playful.</li><li><strong>Laalitaaya (ललिताय)</strong>: Salutations To The one who is beloved, cherished, and fondly treated.</li><li><strong>Sharabhaaya (शरभाय)</strong>: Salutations To The one who takes the form of Sharabha, a mythical creature more powerful than a lion.</li><li><strong>Varadaaya (वरदाय)</strong>: Salutations To The one who is the supreme bestower of all boons and blessings.</li><li><strong>Vandyaaya (वन्याय)</strong>: Salutations To The one who is worthy of all worship, adoration, and reverence.</li><li><strong>Vidushe (विदुषे)</strong>: Salutations To The one who is supremely wise, learned, and a great scholar.</li><li><strong>Vishvasmai (विश्वास्मै)</strong>: Salutations To The one who is the entire universe, the cosmos itself.</li><li><strong>Maheshvaraaya (महेश्वराय)</strong>: Salutations To The one who is the Great God, the supreme Lord of all.</li><li><strong>Vedaantasaarasandohaaya (वेदान्तसारसन्दोहाय)</strong>: Salutations To The one who is the very essence and embodiment of the wisdom of Vedanta.</li><li><strong>Vitataanggaaya (वितताङ्गाय)</strong>: Salutations To The one whose limbs are vast and pervade the entire cosmos.</li><li><strong>Vishaaradaaya (विशारदाय)</strong>: Salutations To The one who is supremely expert, skilled, and proficient in all arts and sciences.</li><li><strong>Vishvamuurtaye (विश्वमूर्तये)</strong>: Salutations To The one whose form is the entire universe.</li><li><strong>Vedavedyaaya (वेदवेद्याय)</strong>: Salutations To The one who can only be known and understood through the sacred Vedas.</li><li><strong>Vaamadevaaya (वामदेवाय)</strong>: Salutations To The one who is the beautiful, pleasing, and noble leftist god.</li><li><strong>Vimocakaaya (विमोचकाय)</strong>: Salutations To The one who is the great liberator, granting ultimate freedom from all bondage.</li><li><strong>Vishvaruupaaya (विश्व रूपाय)</strong>: Salutations To The one who possesses a universal, all-encompassing form.</li><li><strong>Viruupaakshaaya (विरूपाक्षाय)</strong>: Salutations To The one who has an unconventional or odd number of eyes (three eyes).</li><li><strong>Vaaniishaaya (वाणीशाय)</strong>: Salutations To The one who is the supreme lord of speech and eloquence.</li><li><strong>Havyavaahanaaya (हव्यवाहनाय)</strong>: Salutations To The one who is the carrier of oblations Salutations To The  gods, the sacred fire (Agni).</li><li><strong>Vrishaanggaaya (वृषांगाय)</strong>: Salutations To The one whose limbs are as powerful and strong as a bull.</li><li><strong>Vishaalaakshaaya (विशालाक्षाय)</strong>: Salutations To The one who has large, beautiful, and far-seeing eyes.</li><li><strong>Vishvadarshine (विश्वदर्शिने)</strong>: Salutations To The one who is the ultimate witness and seer of the entire universe.</li><li><strong>Vilocanaaya (विलोचनाय)</strong>: Salutations To The one whose eyes are particularly beautiful or special.</li><li><strong>Vishaakhaaya (विशाखाय)</strong>: Salutations To The one who is the deity of the Vishakha constellation, a form of Kartikeya.</li><li><strong>Vishvasrije (विश्वस्रिजे)</strong>: Salutations To The one who is the creator and fashioner of the entire universe.</li><li><strong>Vishvaaya (विश्वस्मै)</strong>: Salutations To The one who is the cosmos, the universe in its entirety.</li><li><strong>Vijitaatmane (विजितात्मने)</strong>: Salutations To The one who has completely conquered his own self and mind.</li><li><strong>Avyayaaya (अव्ययाय)</strong>: Salutations To The one who is imperishable, unchanging, and eternally constant.</li><li><strong>Pumse (पुम्से)</strong>: Salutations To The one who is the ultimate, primordial male, the cosmic person.</li><li><strong>Vyaaghracarmadhritaye (व्याघ्रचर्मधृतये)</strong>: Salutations To The one who wears the skin of a tiger, symbolizing mastery over all wild nature.</li><li><strong>Vyaapine (व्यापिने)</strong>: Salutations To The one who is all-pervading, permeating every particle of the universe.</li><li><strong>Vaangmayaikanidhaye (वांग्मयीकनिधये)</strong>: Salutations To The one who is the sole and ultimate treasure-house of all speech and literature.</li><li><strong>Vibhave (विभवे)</strong>: Salutations To The one who is the supreme, all-powerful, and magnificent Lord.</li><li><strong>Varnaashramagurave (वर्णाश्रमगुरवे)</strong>: Salutations To The one who is the divine preceptor of the system of social and spiritual orders (Varnashrama).</li><li><strong>Varnaaya (वर्णाय)</strong>: Salutations To The one who is the embodiment of all social classes, letters of the alphabet, and colors.</li><li><strong>Varadaaya (वरदाय)</strong>: Salutations To The one who is the generous bestower of all blessings and boons.</li><li><strong>Vaayuvaahanaaya (वायुवाहनाय)</strong>: Salutations To The one who has the wind as his divine vehicle.</li><li><strong>Vishvakarmane (विश्वकर्मणे)</strong>: Salutations To The one who is the divine architect and creator of the entire universe.</li><li><strong>Viniitaatmane (विनीतात्मने)</strong>: Salutations To The one who possesses a humble, well-behaved, and disciplined soul.</li><li><strong>Vedashaastraarthatatvavide (वेदशास्त्रार्थतत्वविदे)</strong>: Salutations To The one who knows the true essence and meaning of the Vedas and all scriptures.</li><li><strong>Vasave (वासवे)</strong>: Salutations To The one who is the embodiment of wealth and one of the celestial Vasus.</li><li><strong>Vasumanase (वसुमनसे)</strong>: Salutations To The one who has a mind that is full of goodness and wealth.</li><li><strong>Paalaaya (पालाय)</strong>: Salutations To The one who is the supreme protector and guardian of all beings.</li><li><strong>Viraamaaya (विरामाय)</strong>: Salutations To The one who is the ultimate cessation, the final resting place of all creation.</li><li><strong>Vidrumacchavaye (विद्रुमच्छवये)</strong>: Salutations To The one whose complexion is as radiant and beautiful as coral.</li><li><strong>Vimocakaaya (विमोकाय)</strong>: Salutations To The one who is the great liberator from all forms of bondage.</li><li><strong>Vijayaaya (विजयाय)</strong>: Salutations To The one who is the ultimate embodiment of victory and triumph.</li><li><strong>Vishishtaaya (विशिष्ठाय)</strong>: Salutations To The one who is the most distinguished, excellent, and special of all.</li><li><strong>Vrishavaahanaaya (वृषवाहनाय)</strong>: Salutations To The one who has the divine bull, Nandi, as his sacred vehicle.</li><li><strong>Vishveshaaya (विश्वेशाय)</strong>: Salutations To The one who is the supreme and undisputed Lord of the entire universe.</li><li><strong>Vividhaaya (विविधाय)</strong>: Salutations To The one who manifests in diverse, manifold, and various forms.</li><li><strong>Vaadine (वादिन)</strong>: Salutations To The one who is the supreme proponent, the ultimate speaker and advocate of truth.</li><li><strong>Vedaanggaaya (वेदांगाय)</strong>: Salutations To The one whose limbs are the auxiliary disciplines of the Vedas.</li><li><strong>Vedavide (वेदविदे)</strong>: Salutations To The one who is the ultimate knower and master of the sacred Vedas.</li><li><strong>Mayaaya (मायाय)</strong>: Salutations To The one who is the master of cosmic illusion and magical creative power.</li><li><strong>Vishveshvaraaya (विश्वेश्वराय)</strong>: Salutations To The one who is the supreme Lord and controller of the entire universe.</li><li><strong>Viirabhadraaya (वीरभद्राय)</strong>: Salutations To The one who is the fierce and heroic warrior, Virabhadra.</li><li><strong>Viiraasiinaaya (वीरासीनाय)</strong>: Salutations To The one who is seated in a heroic and powerful posture.</li><li><strong>Vidhaye (विधये)</strong>: Salutations To The one who is the embodiment of all sacred rules, laws, and destiny.</li><li><strong>Viraaje (विराजे)</strong>: Salutations To The one who shines brilliantly and rules as the ultimate sovereign.</li><li><strong>Vyavasaayaaya (व्यवसायाय)</strong>: Salutations To The one who is the very embodiment of determination, effort, and industry.</li><li><strong>Vyavasthaanaaya (व्यवस्थानाय)</strong>: Salutations To The one who is the basis of all order, structure, and arrangement in the cosmos.</li><li><strong>Viiracuudaamanaye (वीरचूडामणये)</strong>: Salutations To The one who is the crest-jewel of all heroes and valiant warriors.</li><li><strong>Viraaje (विराजे)</strong>: Salutations To The one who is the supreme, shining, and sovereign ruler.</li><li><strong>Vaalakhilyaaya (वालखिल्य)</strong>: Salutations To The one who is the divine sage, the Valakhilya, small in stature but immense in power.</li><li><strong>Vishvadehaaya (विश्वदेहाय)</strong>: Salutations To The one whose body is the entire cosmos.</li><li><strong>Viraamaaya (विरामाय)</strong>: Salutations To The one who is the ultimate resting point, the final pause in the cosmic rhythm.</li><li><strong>Vasudaaya (वसुदाय)</strong>: Salutations To The one who is the generous bestower of all wealth and treasures.</li><li><strong>Vasave (वासवे)</strong>: Salutations To The one who is goodness, wealth, and one of the eight celestial Vasus.</li><li><strong>Vishecanaaya (विषेचनाय)</strong>: Salutations To The one who is the act of sprinkling or consecrating with holy water.</li><li><strong>Vedavedyaaya (वेदवेद्याय)</strong>: Salutations To The one who is the ultimate object of knowledge to be known through the Vedas.</li><li><strong>Vedaaya (वेदाय)</strong>: Salutations To The one who is the personification of the sacred Vedas.</li><li><strong>Vaacaspataye (वाचस्पतये)</strong>: Salutations To The one who is the supreme lord of speech, the master of all language.</li><li><strong>Vashine (वशिन)</strong>: Salutations To The one who has perfect control over his senses and the entire universe.</li><li><strong>Vidvattamaaya (विद्वत्तमाय)</strong>: Salutations To The one who is the wisest and most learned of all scholars.</li><li><strong>Vittamayaaya (वित्तमयाय)</strong>: Salutations To The one who is the very embodiment of all wealth and prosperity.</li><li><strong>Vishrutaye (विश्रुतये)</strong>: Salutations To The one who is widely celebrated and renowned for his great glory.</li><li><strong>Vimalodayaaya (विमलोदयाय)</strong>: Salutations To The one whose appearance is perfectly pure, stainless, and auspicious.</li><li><strong>Vaivasvataaya (वैवस्वताय)</strong>: Salutations To The one who is the current Manu, the progenitor of the human race.</li><li><strong>Vasishthaaya (वसिष्ठाय)</strong>: Salutations To The one who is the most excellent of all, and the great sage Vasistha.</li><li><strong>Vigatajvaraaya (विगतज्वराय)</strong>: Salutations To The one who is completely free from all fever, anxiety, and distress.</li><li><strong>Vishvahartre (विश्वहर्त्रे)</strong>: Salutations To The one who is the ultimate withdrawer and destroyer of the universe.</li><li><strong>Vishvamodine (विश्वमोदिने)</strong>: Salutations To The one who finds joy and delight in the entire universe.</li><li><strong>Vishvaamitraaya (विश्वामित्राय)</strong>: Salutations To The one who is the friend of the whole world, the great sage Vishvamitra.</li><li><strong>Dvijeshvaraaya (द्विजेश्वराय)</strong>: Salutations To The one who is the supreme lord of all the twice-born (the initiated and learned).</li><li><strong>Viirotpattaye (वीरोत्पत्तये)</strong>: Salutations To The one who is the ultimate source and origin of all heroes.</li><li><strong>Vishvasahaaya (विश्वसाहाय)</strong>: Salutations To The one who is the unfailing help and support of the entire universe.</li><li><strong>Vishvaavaasaaya (विश्वावासाय)</strong>: Salutations To The one who is the sacred abode and residence of the entire universe.</li><li><strong>Vasushravase (वसुश्रवसे)</strong>: Salutations To The one who is famous for his immense wealth and glorious hearing.</li><li><strong>Vajrahastaaya (वज्रहस्ताय)</strong>: Salutations To The one who holds the mighty thunderbolt (vajra) in his hand.</li><li><strong>Vajraruupaaya (वजररूपाय)</strong>: Salutations To The one whose form is as hard and indestructible as a diamond.</li><li><strong>Vipaakaaya (विपाकाय)</strong>: Salutations To The one who is the ultimate fruition and consequence of all actions.</li><li><strong>Vishvakaarakaaya (विश्वकारकाय)</strong>: Salutations To The one who is the prime cause and agent of the entire universe.</li><li><strong>Brihadashvaaya (बृहदश्वाय)</strong>: Salutations To The one who possesses great, powerful, and magnificent horses.</li><li><strong>Vyaalakalpaaya (व्यालकल्पाय)</strong>: Salutations To The one who is adorned with serpents as his divine ornaments.</li><li><strong>Vishalyaaya (विशल्याय)</strong>: Salutations To The one who is free from all pain, thorns, and difficulties.</li><li><strong>Lokashalyakrite (लोकशल्यकृते)</strong>: Salutations To The one who removes the painful thorns and miseries of the world.</li><li><strong>Viruupaaya (विरूपाय)</strong>: Salutations To The one who possesses a multiform, unconventional, or even terrifying appearance.</li><li><strong>Vikritaaya (विकृताय)</strong>: Salutations To The one who is modified, changed, or appears in unusual forms.</li><li><strong>Vegine (वेगिने)</strong>: Salutations To The one who possesses incredible, unimaginable speed.</li><li><strong>Virincaye (विरिञ्चये)</strong>: Salutations To The one who is the creator god, Brahma.</li><li><strong>Vishtarashravase (विष्टरश्रवसे)</strong>: Salutations To The one whose fame has spread far and wide, or who has long, attentive ears.</li><li><strong>Avyaktalakshanaaya (अव्यक्तलक्षणाय)</strong>: Salutations To The one whose characteristics are unmanifest, subtle, and imperceptible.</li><li><strong>Avyaktaaya (अव्यक्ताय)</strong>: Salutations To The one who is unmanifest, invisible, and the uncaused cause of all.</li><li><strong>Vyaktaaya (व्यक्ताय)</strong>: Salutations To The one who is manifest, visible, and has become the entire perceptible universe.</li><li><strong>Vaishyaaya (वैश्याय)</strong>: Salutations To The one who is the embodiment of the merchant and agricultural class (Vaishya).</li><li><strong>Vishaampataye (विशांपतये)</strong>: Salutations To The one who is the lord and protector of all people and tribes.</li><li><strong>Vibudhaagresaraaya (विबुधाग्रेसराय)</strong>: Salutations To The one who is the foremost leader and chief of all the wise and enlightened gods.</li><li><strong>Vedaaya (वेदाय)</strong>: Salutations To The one who is the ultimate, sacred knowledge of the Vedas.</li><li><strong>Vishvagarbhaaya (विश्वगर्भाय)</strong>: Salutations To The one who contains the entire universe within his womb.</li><li><strong>Vicakshanaaya (विचक्षणाय)</strong>: Salutations To The one who is exceedingly wise, skillful, and discerning.</li><li><strong>Vishamaakshaaya (विषमाक्षाय)</strong>: Salutations To The one who has an odd number of eyes (three), symbolizing unevenness and power.</li><li><strong>Vilomaakshaaya (विलोमाक्षाय)</strong>: Salutations To The one whose eyes are turned inwards, symbolizing introspection, or has terrifying eyes.</li><li><strong>Vrishadaaya (वृषदाय)</strong>: Salutations To The one who is the bestower of righteousness, virtue, and desires.</li><li><strong>Vrishavarddhanaaya (वृषवर्धनाय)</strong>: Salutations To The one who causes righteousness and virtue to grow and flourish.</li><li><strong>Viviktadaaya (विविक्तदाय)</strong>: Salutations To The one who bestows solitude, discrimination, and a secluded place for spiritual practice.</li><li><strong>Vasantaaya (वसन्ताय)</strong>: Salutations To The one who is the very embodiment of the beautiful and vibrant spring season.</li><li><strong>Vivasvate (विवस्वते)</strong>: Salutations To The one who is the radiant sun god, Vivasvan.</li><li><strong>Vitamase (वितामसे)</strong>: Salutations To The one who is completely free from all darkness, ignorance, and impurity.</li><li><strong>Tamase (तमसे)</strong>: Salutations To The one who is the embodiment of darkness, inertia, and the power of dissolution (Tamas).</li><li><strong>Vedavedyaaya (वेदवेद्याय)</strong>: Salutations To The one who is the ultimate truth to be known through the sacred Vedas.</li><li><strong>Vishvaruupaaya (विश्व रूपाय)</strong>: Salutations To The one whose form encompasses the entire universe.</li><li><strong>Viviktaaya (विविक्ताय)</strong>: Salutations To The one who is solitary, secluded, and distinct from all of creation.</li><li><strong>Vishvabhaajanaaya (विश्वभाजनाय)</strong>: Salutations To The one who is the worthy vessel and recipient of the entire universe.</li><li><strong>Vishayasthaaya (विषयस्थाय)</strong>: Salutations To The one who resides within all objects of the senses, yet remains untouched.</li><li><strong>Viviktasthaaya (विविक्तस्थाय)</strong>: Salutations To The one who dwells in solitude and is eternally separate from the material world.</li><li><strong>Vidyaaraashaye (विद्याराशये)</strong>: Salutations To The one who is a great, immeasurable heap of all knowledge and learning.</li><li><strong>Patipriyaaya (पतिप्रियाय)</strong>: Salutations To The one who is dearly beloved by his consort, the divine mother.</li><li><strong>Shivaaya (शिवाय)</strong>: Salutations To The one who is eternally auspicious, benevolent, and the source of all goodness.</li><li><strong>Sharvaaya (शर्वाय)</strong>: Salutations To The one who is the divine archer, the one who destroys the universe with his arrows.</li><li><strong>Sadaacaaraaya (सदाचाराय)</strong>: Salutations To The one who is the embodiment of righteous, noble, and virtuous conduct.</li><li><strong>Shambhave (शम्भवे)</strong>: Salutations To The one who is the ultimate source of all happiness, bliss, and prosperity.</li><li><strong>Iishaanaaya (ईशानाय)</strong>: Salutations To The one who is the supreme ruler, the reigning and controlling lord of all.</li><li><strong>Iishvaraaya (ईश्वराय)</strong>: Salutations To The one who is the supreme, all-powerful Lord and controller of the cosmos.</li><li><strong>Shrutidharmoktasamvaadine (श्रुतिधर्मोक्तसंवादिने)</strong>: Salutations To The one whose teachings are in perfect harmony with the principles declared in the scriptures (Shruti).</li><li><strong>Sahasraakshaaya (सहस्राक्षाय)</strong>: Salutations To The one who possesses a thousand eyes, seeing and knowing everything in the universe.</li><li><strong>Sahasrapaade (सहस्रपादे)</strong>: Salutations To The one who has a thousand feet, representing his all-pervading presence.</li><li><strong>Sarvajnaaya (सर्वज्ञाय)</strong>: Salutations To The one who is all-knowing, omniscient, and possesses complete knowledge.</li><li><strong>Sarvadevaaya (सर्वदेवाय)</strong>: Salutations To The one who is the god of all gods, the embodiment of all deities.</li><li><strong>Shangkaraaya (शङ्कराय)</strong>: Salutations To The one who is the great bestower of happiness, peace, and auspiciousness.</li><li><strong>Shuuladhaarakaaya (शूलधारकाय)</strong>: Salutations To The one who holds the mighty trident (shula), a symbol of his power to destroy evil.</li><li><strong>Shucaye (शुचये)</strong>: Salutations To The one who is spotlessly clean, pure, and undefiled.</li><li><strong>Raashaye (राशिभ्यो)</strong>: Salutations To The one who is the aggregate, the great heap of all existence.</li><li><strong>Skandagurave (स्कंदगुरवे)</strong>: Salutations To The one who is the revered spiritual preceptor (guru) of Skanda (Kartikeya).</li><li><strong>Shriikanthaaya (श्रीकण्ठाय)</strong>: Salutations To The one whose throat is beautifully radiant or adorned (as in Nilakantha).</li><li><strong>Suuryataapanaaya (सूर्यतापनाय)</strong>: Salutations To The one who is the scorching heat of the sun, who burns away all impurities.</li><li><strong>Iishaananilayaaya (ईशानानिलयाय)</strong>: Salutations To The one who has the northeast direction (Ishana) as his sacred abode.</li><li><strong>Svasti (स्वस्ति)</strong>: Salutations To The one who is the embodiment of all well-being, fortune, and auspiciousness.</li><li><strong>Saamavedasvaruupavide (सामवेदस्वरूपविदे)</strong>: Salutations To The one who knows the true nature and form of the sacred Sama Veda.</li><li><strong>Maanine (मानिने)</strong>: Salutations To The one who is full of divine pride, honored, and respected by all.</li><li><strong>Suniitaye (सुनीति)</strong>: Salutations To The one who is the embodiment of wise conduct and excellent, righteous guidance.</li><li><strong>Shuddhaatmane (शुद्धात्मने)</strong>: Salutations To The one who possesses a completely pure, untainted, and stainless soul.</li><li><strong>Somaaya (सोमाय)</strong>: Salutations To The one who is the sacred nectar of the moon (Soma), or is always with Uma (Sa-Uma).</li><li><strong>Sometaraaya (सोमताराय)</strong>: Salutations To The one who is different from the moon, or is the supreme reality beyond the mind.</li><li><strong>Sukhine (सुखिने)</strong>: Salutations To The one who is eternally happy, blissful, and full of joy.</li><li><strong>Sadaashivaaya (सदाशिवाय)</strong>: Salutations To The one who is eternally auspicious, benevolent, and gracious.</li><li><strong>Samaavrittaaya (समावृत्ताय)</strong>: Salutations To The one who is well-rounded, complete, and lives a balanced life.</li><li><strong>Sukiirtaye (सुक्रीतये)</strong>: Salutations To The one who possesses great, noble, and auspicious fame.</li><li><strong>Chinnasamshayaaya (छिन्नसंशयाय)</strong>: Salutations To The one for whom all doubts and confusions have been completely resolved and cut asunder.</li><li><strong>Sarvakaamine (सर्वकामिने)</strong>: Salutations To The one who is the embodiment of all desires, and fulfills all wishes.</li><li><strong>Sadaavaasaaya (सदावासाय)</strong>: Salutations To The one who is the eternal and permanent abode for all beings.</li><li><strong>Sarvaayudhavishaaradaaya (सर्वायुधविशारदाय)</strong>: Salutations To The one who is a supreme expert and master of all forms of weapons.</li><li><strong>Sulabhaaya (सुलभाय)</strong>: Salutations To The one who is easily accessible and attainable for his true devotees.</li><li><strong>Suudanaaya (सूदनाय)</strong>: Salutations To The one who is the great and mighty slayer of all evil forces.</li><li><strong>Shuddhaaya (शुद्धाय)</strong>: Salutations To The one who is eternally pure, clean, and free from all defilement.</li><li><strong>Shubhaamshave (शुभांशवे)</strong>: Salutations To The one whose rays and emanations are supremely auspicious.</li><li><strong>Shuddhavigrahaaya (शुद्धविग्रहाय)</strong>: Salutations To The one who possesses a divine form that is perfectly pure and untainted.</li><li><strong>Suvarnaaya (सुवर्णाय)</strong>: Salutations To The one who is of a beautiful, golden color, or who is the source of all gold.</li><li><strong>Svaashrayaaya (स्वाश्रयाय)</strong>: Salutations To The one who is self-dependent, the ultimate support of himself.</li><li><strong>Shatrave (शत्रवे)</strong>: Salutations To The one who is a formidable and destructive enemy Salutations To The  wicked.</li><li><strong>Shatrujite (शत्रुजिते)</strong>: Salutations To The one who is the absolute conqueror of all his enemies.</li><li><strong>Shatrutaapanaaya (शत्रुतापनाय)</strong>: Salutations To The one who causes great torment and heat to his enemies.</li><li><strong>Shanaye (शनये)</strong>: Salutations To The one who moves slowly, the planet Saturn, who bestows the fruits of karma.</li><li><strong>Suuryaaya (सूर्याय)</strong>: Salutations To The one who is the divine sun, the source of all light and life.</li><li><strong>Sarvakarmane (सर्वकर्मणे)</strong>: Salutations To The one who is the agent and witness of all actions in the universe.</li><li><strong>Sarvalokaprajaapataye (सर्वलोकप्रजापतये)</strong>: Salutations To The one who is the lord and progenitor of all beings in all the worlds.</li><li><strong>Siddhaaya (सिद्धाय)</strong>: Salutations To The one who is the perfected being, the eternally accomplished one.</li><li><strong>Sarveshvaraaya (सर्वेश्वराय)</strong>: Salutations To The one who is the supreme lord and master of all existence.</li><li><strong>Svastaye (स्वस्तये)</strong>: Salutations To The one who is the ultimate source of all well-being and good fortune.</li><li><strong>Svastikrite (स्वस्तिकृते)</strong>: Salutations To The one who is the creator and bringer of all auspiciousness.</li><li><strong>Svastibhuje (स्वस्तिभुजे)</strong>: Salutations To The one who enjoys and partakes in all that is auspicious.</li><li><strong>Svadhaayai (स्वधायै)</strong>: Salutations To The one who is the sacred sacrificial offering (Svadha) made Salutations To The  ancestors.</li><li><strong>Vasave (वासवे)</strong>: Salutations To The one who is the embodiment of goodness, radiance, and wealth.</li><li><strong>Vasumanase (वसुमनसे)</strong>: Salutations To The one who possesses a benevolent, kind, and excellent mind.</li><li><strong>Satyaaya (सत्याय)</strong>: Salutations To The one who is the ultimate truth, the absolute and unchanging reality.</li><li><strong>Sarvapaapaharaaya (सर्वपापहराय)</strong>: Salutations To The one who is the supreme remover and destroyer of all sins.</li><li><strong>Haraaya (हराय)</strong>: Salutations To The one who is the great seizer, the one who forcibly removes all sins, sorrows, and ignorance.</li><li><strong>Sarvaadaye (सर्वादि)</strong>: Salutations To The one who is the primordial beginning and origin of all things.</li><li><strong>Siddhidaaya (सिद्धिदाय)</strong>: Salutations To The one who is the generous bestower of all supernatural powers and accomplishments (siddhis).</li><li><strong>Siddhaye (सिद्धये)</strong>: Salutations To The one who is the embodiment of spiritual accomplishment and perfection itself.</li><li><strong>Sarvaavaasaaya (सर्वावासाय)</strong>: Salutations To The one who is the ultimate abode and dwelling place for all beings.</li><li><strong>Catushpathaaya (चतुष्पथाय)</strong>: Salutations To The one who is at the crossroads of the four paths, representing all possible directions and destinies.</li><li><strong>Samvatsarakaraaya (संवत्सरकराय)</strong>: Salutations To The one who is the creator of the cycle of years (Samvatsara).</li><li><strong>Shriimate (श्रीमते)</strong>: Salutations To The one who is glorious, prosperous, and endowed with all divine splendors (Shri).</li><li><strong>Shaantaaya (शान्ताय)</strong>: Salutations To The one who is perfectly peaceful, calm, and eternally tranquil.</li><li><strong>Samvatsaraaya (संवत्सराय)</strong>: Salutations To The one who is the embodiment of the year, the cycle of time itself.</li><li><strong>Shishave (शिशवे)</strong>: Salutations To The one who takes the innocent and pure form of a child.</li><li><strong>Spashtaaksharaaya (स्पष्टाक्षराय)</strong>: Salutations To The one who is the clear, distinct, and imperishable syllable (Aum).</li><li><strong>Sarvahaarine (सर्वहारिणे)</strong>: Salutations To The one who is the great destroyer and withdrawer of all things at the end of time.</li><li><strong>Sanggraamaaya (संग्रामय)</strong>: Salutations To The one who is the embodiment of battle, the cosmic war against evil.</li><li><strong>Sanggamaaya (संग्गमाय)</strong>: Salutations To The one who is the sacred confluence, the perfect union of all things.</li><li><strong>Plavaaya (प्लवाय)</strong>: Salutations To The one who is the divine ferry-boat that carries souls across the ocean of worldly existence.</li><li><strong>Ishtaaya (इष्टाय)</strong>: Salutations To The one who is the most beloved, the chosen and worshipped deity.</li><li><strong>Vishishtaaya (विशिष्टाय)</strong>: Salutations To The one who is the most excellent, distinguished, and unique of all.</li><li><strong>Shishteshtaaya (शिष्टेष्टाय)</strong>: Salutations To The one who is dearly beloved by the righteous, the wise, and the disciplined.</li><li><strong>Sulabhaaya (सुलभाय)</strong>: Salutations To The one who is easy to attain and approach for his sincere devotees.</li><li><strong>Sulabhaayanaaya (सुलभायनाय)</strong>: Salutations To The one whose path is easy to follow for the pure of heart.</li><li><strong>Subrahmanyaaya (सुब्रह्मण्याय)</strong>: Salutations To The one who is dear Salutations To The  Brahmins and is the embodiment of sacred knowledge, Lord Subrahmanya.</li><li><strong>Suraganaaya (सुरगणाय)</strong>: Salutations To The one who is the divine leader of the celestial hosts of gods.</li><li><strong>Susharanyaaya (सुशरण्याय)</strong>: Salutations To The one who is the most excellent and supreme refuge for all beings.</li><li><strong>Sudhaapataye (सुधापतये)</strong>: Salutations To The one who is the divine lord and master of the immortal nectar (Sudha).</li><li><strong>Sharanyaaya (शरण्याय)</strong>: Salutations To The one who is the ultimate refuge, worthy of being sought for absolute protection.</li><li><strong>Shaashvataaya (शाश्वताय)</strong>: Salutations To The one who is eternal, permanent, and unchanging.</li><li><strong>Skandaaya (स्कंदाय)</strong>: Salutations To The one who is the attacker or the 'spilled one', Lord Kartikeya.</li><li><strong>Shipivishtaaya (शिपिविष्टाय)</strong>: Salutations To The one who is pervaded by rays of light, or who is like an uncovered sacrificial animal (symbolizing the Self).</li><li><strong>Shivaashrayaaya (शिवाश्रयाय)</strong>: Salutations To The one who is the ultimate foundation and supreme shelter of all that is auspicious.</li><li><strong>Samsaaracakrabhrite (संसारचक्रभृते)</strong>: Salutations To The one who holds and sustains the great wheel of worldly existence (samsara).</li><li><strong>Saaraaya (साराय)</strong>: Salutations To The one who is the ultimate essence, the highest and most fundamental reality.</li><li><strong>Shangkaraaya (शंकराय)</strong>: Salutations To The one who is the bringer of peace, happiness, and auspiciousness.</li><li><strong>Sarvasaadhakaaya (सर्वसाधकाय)</strong>: Salutations To The one who is the ultimate means for accomplishing all goals and desires.</li><li><strong>Asraaya (अस्त्राय)</strong>: Salutations To The one who is the divine, supernatural missile or weapon.</li><li><strong>Shastraaya (शस्त्राय)</strong>: Salutations To The one who is the sacred, hand-held weapon of divine power.</li><li><strong>Saptaganaaya (सप्तगनाय)</strong>: Salutations To The one who is attended by the seven groups of celestial beings.</li><li><strong>Savitre (सवित्रे)</strong>: Salutations To The one who is the divine impeller, the radiant sun god Savitr.</li><li><strong>Sakalaagamaaya (सकलागमाय)</strong>: Salutations To The one who is the ultimate source and embodiment of all sacred scriptures (Agamas).</li><li><strong>Suciiraaya (सुचीराय)</strong>: Salutations To The one who is of a very noble and excellent lineage.</li><li><strong>Saptadorviiraaya (सप्तदोर्वीराय)</strong>: Salutations To The one who is the great hero with seven mighty arms.</li><li><strong>Shadvimshaaya (षड्विंशायाय)</strong>: Salutations To The one who is the twenty-sixth principle, the Purusha, beyond the 25 tattvas.</li><li><strong>Sarvadhrishe (सर्वदृशे)</strong>: Salutations To The one who is the all-seeing witness of the entire universe.</li><li><strong>Svaraaje (स्वाराजे)</strong>: Salutations To The one who is self-ruling, the absolute and independent sovereign.</li><li><strong>Samraaje (सम्राजे)</strong>: Salutations To The one who is the supreme emperor, the ruler of all other kings.</li><li><strong>Sushenaaya (सुषेणाय)</strong>: Salutations To The one who possesses a beautiful, victorious, and divine army.</li><li><strong>Shatrughnaaya (शत्रुघ्नाय)</strong>: Salutations To The one who is the absolute destroyer and slayer of all enemies.</li><li><strong>Shuurashatrave (शूरशत्रवे)</strong>: Salutations To The one who is a formidable enemy to all the heroic yet wicked demons.</li><li><strong>Shubhodayaaya (शुभोट्यावाय)</strong>: Salutations To The one whose appearance brings auspiciousness, prosperity, and good fortune.</li><li><strong>Samarthaaya (समर्थाय)</strong>: Salutations To The one who is all-powerful, supremely capable, and competent in every respect.</li><li><strong>Sugamaaya (सुगमाय)</strong>: Salutations To The one who is easy to approach, whose path is smooth and accessible.</li><li><strong>Shukraaya (शुक्राय)</strong>: Salutations To The one who is brilliantly pure, radiant, and the planet Venus (Shukra), the preceptor of the demons.</li><li><strong>Sadyogine (सद्योगिने)</strong>: Salutations To The one who instantly unites with his devotees, the true and perfect yogi.</li><li><strong>Sadasanmayaaya (सदासन्मयाय)</strong>: Salutations To The one who is the embodiment of both existence (sat) and non-existence (asat).</li><li><strong>Shaasranetraaya (शास्रनेतृाय)</strong>: Salutations To The one who sees the world through the eyes of a thousand sacred scriptures.</li><li><strong>Sukhashmashrave (सुखश्मश्रवे)</strong>: Salutations To The one who has pleasant and auspicious ears, who hears all sacred sounds.</li><li><strong>Svaadhishthaanashadaashrayaaya (स्वाधिष्ठानषडाश्रयाय)</strong>: Salutations To The one who is the sixfold foundation of the Svadhisthana chakra.</li><li><strong>Praamshave (प्रांशवे)</strong>: Salutations To The one who is of a tall, imposing, and magnificent stature.</li><li><strong>Saptapataye (सप्तपतये)</strong>: Salutations To The one who is the lord of the seven worlds, the seven sages, or the seven cosmic planes.</li><li><strong>Vriddhaaya (वृद्धाय)</strong>: Salutations To The one who is ancient, old, wise, and venerable.</li><li><strong>Shamanaaya (शमनाय)</strong>: Salutations To The one who is the great pacifier, who brings peace and quells all disturbances.</li><li><strong>Shikhisaarathaye (शिखिसारथये)</strong>: Salutations To The one who has the divine fire (Shikhi) as his charioteer.</li><li><strong>Supratiikaaya (सुप्रतीकाय)</strong>: Salutations To The one who has a beautiful, excellent, and auspicious form.</li><li><strong>Suvriddhaatmane (सुवृद्धात्मने)</strong>: Salutations To The one whose soul is supremely virtuous, well-developed, and righteous.</li><li><strong>Samsrishtaaya (संसृष्टाय)</strong>: Salutations To The one who is perfectly united and mingled with all of creation.</li><li><strong>Sukhavaangnidhaye (सुखवांग्निधये)</strong>: Salutations To The one who is a treasure-house of pleasant speech and happy words.</li><li><strong>Sukhaanilaaya (सुखानिळाया)</strong>: Salutations To The one who is like a pleasant and gentle breeze, bringing comfort and joy.</li><li><strong>Susampannaaya (सुसंपन्नाय)</strong>: Salutations To The one who is endowed with great wealth, prosperity, and all divine qualities.</li><li><strong>Surabhaye (सुरभये)</strong>: Salutations To The one who is fragrant, charming, and the celestial wish-fulfilling cow (Surabhi).</li><li><strong>Shishiraatmakaaya (शिशिरआत्मकाय)</strong>: Salutations To The one who is cool and refreshing like the winter season, the very soul of coolness.</li><li><strong>Sarvadevamayaaya (सर्वदेवमयाय)</strong>: Salutations To The one who is composed of and contains all the gods within himself.</li><li><strong>Shailaaya (शैलाय)</strong>: Salutations To The one who is the mighty, unshakeable mountain.</li><li><strong>Sarvashaastraprabhanjanaaya (सर्वशास्त्रप्रभंजनाय)</strong>: Salutations To The one who is the great shatterer of the arguments of all other schools of thought.</li><li><strong>Shivaalayaaya (शिवालयया)</strong>: Salutations To The one who is the sacred and auspicious abode of Shiva.</li><li><strong>Suuryaruupaaya (सूर्यरूपाय)</strong>: Salutations To The one who has the brilliant and radiant form of the sun.</li><li><strong>Sahasramukhanaashakaaya (सहस्रमुखनाशकाय)</strong>: Salutations To The one who is the destroyer of the thousand-faced demon.</li><li><strong>Sahasrabaahave (सहस्रबाहवे)</strong>: Salutations To The one who possesses a thousand mighty and powerful arms.</li><li><strong>Sarveshaaya (सर्वेशाय)</strong>: Salutations To The one who is the supreme lord and master of all.</li><li><strong>Saaramaaya (सारमाय)</strong>: Salutations To The one who is the embodiment of all essence and the highest truth.</li><li><strong>Sarvalokadhrite (सर्वलोकधृते)</strong>: Salutations To The one who is the ultimate supporter and upholder of all the worlds.</li><li><strong>Duutyamshaaya (दूत्यांशाय)</strong>: Salutations To The one who has a portion of the divine messenger's power.</li><li><strong>Surasevyaamshaaya (सुरसेव्यमंशाय)</strong>: Salutations To The one who has a part that is worshipped by all the divine gods.</li><li><strong>Sarvadevottamottamaaya (सर्वदेवोत्तमत्तमाय)</strong>: Salutations To The one who is the absolute best among the best of all the gods.</li><li><strong>Shivadhyaanarataaya (शिवाध्यानरताय)</strong>: Salutations To The one who is constantly and deeply absorbed in the meditation of Shiva.</li><li><strong>Shriimate (श्रीमते)</strong>: Salutations To The one who is possessed of all divine glory, wealth, and auspiciousness (Shri).</li><li><strong>Shikhine (शिखिने)</strong>: Salutations To The one who has a top-knot or a crest, like a peacock.</li><li><strong>Shriicandikaadhipaaya (श्रीचण्डिकाधिपाय)</strong>: Salutations To The one who is the supreme lord of the glorious goddess Chandika.</li><li><strong>Shmashaananilayaaya (श्मशाननिलायाय)</strong>: Salutations To The one who has the cremation ground as his sacred and chosen abode.</li><li><strong>Setave (सेतवे)</strong>: Salutations To The one who is the sacred bridge that allows one to cross the ocean of worldly existence.</li><li><strong>Sarvadevaaya (सर्वदेवाय)</strong>: Salutations To The one who is the God of all gods.</li><li><strong>Maheshvaraaya (महेश्वराय)</strong>: Salutations To The one who is the great and supreme Lord.</li><li><strong>Suvishtapine (सुविष्ठपिने)</strong>: Salutations To The one who is the beautiful, sacred branch or the well-established peak.</li><li><strong>Suraaraadhyaaya (सुराराध्याय)</strong>: Salutations To The one who is worthy of being worshipped by all the divine gods.</li><li><strong>Sukumaaraaya (सुकुमाराय)</strong>: Salutations To The one who is exceedingly tender, delicate, and beautiful.</li><li><strong>Sulocanaaya (सुलोचनाय)</strong>: Salutations To The one who possesses beautiful, captivating eyes.</li><li><strong>Sakalaaya (सकलाय)</strong>: Salutations To The one who is complete, whole, with all parts, and the manifest form of reality.</li><li><strong>Sumataaya (सुमताय)</strong>: Salutations To The one who possesses a good, noble, and benevolent mind.</li><li><strong>Svarnaaya (स्वर्णाय)</strong>: Salutations To The one who is the precious and radiant metal, gold.</li><li><strong>Svarmine (स्वर्मिणे)</strong>: Salutations To The one who is the lord of heaven (Svarga).</li><li><strong>Svaramathanaaya (स्वरमथनाय)</strong>: Salutations To The one who churns the celestial ocean of musical notes.</li><li><strong>Svanaaya (स्वनाय)</strong>: Salutations To The one who is the divine, resonant sound.</li><li><strong>Saamagaaya (सामगाय)</strong>: Salutations To The one who is the supreme singer of the sacred Sama Veda chants.</li><li><strong>Sakalaadhaaraaya (सकलाधाराय)</strong>: Salutations To The one who is the ultimate foundation and support of everything.</li><li><strong>Saamagaanapriyaaya (सामगानप्रियाय)</strong>: Salutations To The one who is deeply fond of the singing of the Sama Veda.</li><li><strong>Shucaye (शुचये)</strong>: Salutations To The one who is perfectly pure, clean, and radiant.</li><li><strong>Tasmai (तस्मै)</strong>: To 'That' one, the ultimate, indescribable reality.</li><li><strong>Iitaye (ईतिषे)</strong>: Salutations To The one who is the embodiment of all that is desired and sought after.</li><li><strong>Satkritaaya (सत्कृताय)</strong>: Salutations To The one who is honored, worshipped, and well-respected by all.</li><li><strong>Shaantaaya (शान्ताय)</strong>: Salutations To The one who is supremely peaceful, calm, and untroubled.</li><li><strong>Subhuumaye (सुभूमये)</strong>: Salutations To The one who is the good and beautiful earth, the firm foundation.</li><li><strong>Satparaayanaaya (सत्परायणाय)</strong>: Salutations To The one who is the supreme and ultimate goal for all truthful and virtuous beings.</li><li><strong>Shriivallabhaaya (श्रीवल्लभाय)</strong>: Salutations To The one who is the beloved consort of Shri (Goddess Lakshmi), a name usually for Vishnu but here indicating supreme prosperity.</li><li><strong>Shivaarambhaaya (शिवायंभ्याय)</strong>: Salutations To The one who is the auspicious beginning of all things.</li><li><strong>Shaantabhadraaya (शान्तभद्राय)</strong>: Salutations To The one who is peaceful, gentle, and supremely auspicious.</li><li><strong>Samanjasaaya (समंजसाय)</strong>: Salutations To The one who is proper, right, and perfectly harmonious.</li><li><strong>Satyavaace (सत्यवाचे)</strong>: Salutations To The one whose speech is always and unfailingly true.</li><li><strong>Saatvikaaya (सात्विकाय)</strong>: Salutations To The one who is the embodiment of the quality of purity, goodness, and truth (Sattva).</li><li><strong>Satyaaya (सत्याय)</strong>: Salutations To The one who is the absolute, unchanging truth and reality.</li><li><strong>Sarvajite (सर्वजिते)</strong>: Salutations To The one who is the all-conquering, victorious over everything.</li><li><strong>Shrutisaagaraaya (श्रुतिसागराय)</strong>: Salutations To The one who is a vast and deep ocean of all sacred learning (Shruti).</li><li><strong>Sahasraarcishe (सहस्रार्चिषे)</strong>: Salutations To The one who possesses a thousand brilliant rays of light.</li><li><strong>Sadaajishnave (सदाजिष्णवे)</strong>: Salutations To The one who is always victorious and ever-triumphant.</li><li><strong>Saptaye (सप्ताये)</strong>: Salutations To The one who is the divine, swift horse, or the number seven.</li><li><strong>Saptajaneshvaraaya (सप्तजनेश्वराय)</strong>: Salutations To The one who is the supreme lord of the seven types of people or the seven worlds.</li><li><strong>Samhaarakaaranaaya (संहारककारणाय)</strong>: Salutations To The one who is the ultimate cause of the cosmic dissolution and destruction.</li><li><strong>Shuddhaaya (शुद्धाय)</strong>: Salutations To The one who is spotlessly pure and eternally clean.</li><li><strong>Shatrughnaaya (शत्रुघ्नाय)</strong>: Salutations To The one who is the absolute slayer of all his enemies.</li><li><strong>Svarnadaayakaaya (स्वर्णदायकाय)</strong>: Salutations To The one who is the generous bestower of gold and great wealth.</li><li><strong>Sureshaaya (सुरेशाय)</strong>: Salutations To The one who is the supreme lord and chief of all the gods.</li><li><strong>Sharanaaya (शरणाय)</strong>: Salutations To The one who is the ultimate refuge, providing absolute safety and protection.</li><li><strong>Sharmane (शर्मणे)</strong>: Salutations To The one who is the source of all happiness, bliss, and protection.</li><li><strong>Sarvasmai (सर्वस्मै)</strong>: Salutations To The one who is everything, the all, the totality of existence.</li><li><strong>Vedaaya (वेदाय)</strong>: Salutations To The one who is the personification of the sacred Vedas.</li><li><strong>Sataanggataye (सताङ्गतये)</strong>: Salutations To The one who is the ultimate goal for all virtuous and good beings.</li><li><strong>Samvritaaya (संवृताय)</strong>: Salutations To The one who is concealed, veiled, and hidden from ordinary view.</li><li><strong>Asamvritaaya (असंवृताय)</strong>: Salutations To The one who is completely unconcealed, open, and revealed to his devotees.</li><li><strong>Shilpine (शिल्पिने)</strong>: Salutations To The one who is the supreme artist, the master craftsman of the universe.</li><li><strong>Siddhidaaya (सिद्धिदाय)</strong>: Salutations To The one who is the bestower of all supernatural powers and accomplishments.</li><li><strong>Svarnasiddhidaaya (स्वर्णसिद्धिदाय)</strong>: Salutations To The one who grants the magical power of creating gold.</li><li><strong>Shaantabuddhaye (शांतबुद्धये)</strong>: Salutations To The one who possesses a calm, serene, and peaceful intellect.</li><li><strong>Shuddhabuddhaye (शुद्धबुद्धये)</strong>: Salutations To The one who has a perfectly pure and untainted intellect.</li><li><strong>Stavyaaya (स्त्यवाय)</strong>: Salutations To The one who is worthy of being praised and extolled by all.</li><li><strong>Stotre (स्तोत्रे)</strong>: Salutations To The one who is the hymn of praise itself.</li><li><strong>Stavapriyaaya (स्तवप्रियाय)</strong>: Salutations To The one who is deeply fond of the hymns and praises offered by his devotees.</li><li><strong>Rasajnaaya (रसज्ञाय)</strong>: Salutations To The one who is the supreme knower of all essences, tastes, and aesthetic experiences (rasa).</li><li><strong>Svarnaruupaaya (स्वर्णरूपाय)</strong>: Salutations To The one who has a beautiful, radiant form made of pure gold.</li><li><strong>Shuddhaye (शुद्धाय)</strong>: Salutations To The one who is the very embodiment of absolute purity and sanctification.</li><li><strong>Raajne (राज्ने)</strong>: Salutations To The one who is the supreme king, the ultimate sovereign of all.</li><li><strong>Vashat (वषट)</strong>: The sacred exclamation made while offering oblations inSalutations To The  fire, symbolizing the deity himself.</li><li><strong>Namo (नमो)</strong>: The sacred salutation of 'I bow to you,' representing the act of reverence itself.</li><li><strong>Sthuulaaya (स्थूलाय)</strong>: Salutations To The one who is of a vast, gross, and immense physical form.</li><li><strong>Suukshmaaya (सूक्ष्माय)</strong>: Salutations To The one who is subtle, minute, and imperceptible.</li><li><strong>Sahasraarkaprakaashaaya (सहस्रार्कप्रकाशाय)</strong>: Salutations To The one who shines with the dazzling brilliance of a thousand suns.</li><li><strong>Sarvatomukhaaya (सर्वतोमुखाय)</strong>: Salutations To The one who has faces in every direction, seeing and knowing all.</li><li><strong>Saarameyaanugaaya (सारमेयानुगाय)</strong>: Salutations To The one who is followed and attended by celestial dogs.</li><li><strong>Shambhave (शंभवे)</strong>: Salutations To The one who is the source of all happiness and auspiciousness.</li><li><strong>Pretavaahaaya (प्रेतवाहाय)</strong>: Salutations To The one who has ghosts and spirits of the deceased as his vehicle.</li><li><strong>Sahasrakrite (सहस्रकृते)</strong>: Salutations To The one who is the creator of thousands of things, or who acts a thousandfold.</li><li><strong>Grahaatmakaaya (ग्रहात्मकाय)</strong>: Salutations To The one who is the very soul and essence of the celestial planets (grahas).</li><li><strong>Rudraruupaaya (रुद्ररूपाय)</strong>: Salutations To The one who possesses the fierce, roaring, and terrifying form of Rudra.</li><li><strong>Vasvashtasvarnakrite (वसवष्टस्वर्णकृते)</strong>: Salutations To The one who creates the eight forms of wealth (Vasus) and gold.</li><li><strong>Vashine (वशिने)</strong>: Salutations To The one who has perfect control over himself and the entire cosmos.</li><li><strong>Aadityaaya (आदित्याय)</strong>: Salutations To The one who is the radiant sun god, Aditi's son.</li><li><strong>Sarvakartre (सर्वकर्त्रे)</strong>: Salutations To The one who is the ultimate doer and creator of all things.</li><li><strong>Sarvagaaya (सर्वगाय)</strong>: Salutations To The one who is all-pervading, present everywhere and in everything.</li><li><strong>Svarnasiddhidaaya (स्वर्णसिद्धिदाय)</strong>: Salutations To The one who grants the divine power to create gold.</li><li><strong>Sadaarushtaaya (सदारुष्टाय)</strong>: Salutations To The one who is perpetually angry and wrathful towards evil.</li><li><strong>Svarnadaatre (स्वर्णदात्रे)</strong>: Salutations To The one who is the most generous giver of gold and wealth.</li><li><strong>Ghurghuraaya (घुर्घुराय)</strong>: Salutations To The one who makes a deep, gurgling or rumbling sound.</li><li><strong>Raktalocanaaya (रक्तलोचनाय)</strong>: Salutations To The one who has fierce, blood-red eyes.</li><li><strong>Paadukaasiddhidaaya (पादुकासिद्धिदयाय)</strong>: Salutations To The one who grants supernatural powers through his sacred sandals (padukas).</li><li><strong>Paataaya (पाताय)</strong>: Salutations To The one who is the ultimate protector and guardian.</li><li><strong>Paarushyavinishuudanaaya (पारुष्यविनिषूदनाय)</strong>: Salutations To The one who is the absolute destroyer of all harshness and cruelty.</li><li><strong>Ashtasiddhiye (अष्टसिद्धये)</strong>: Salutations To The one who is the embodiment of the eight great supernatural powers (Ashta Siddhis).</li><li><strong>Mahaasiddhaye (महासद्धये)</strong>: Salutations To The one who is the greatest and most supreme of all divine accomplishments.</li><li><strong>Suprasiddhaye (सुप्रसिद्धये)</strong>: Salutations To The one who is extremely famous and renowned throughout the cosmos.</li><li><strong>Svarnadaaya (स्वर्णदाय)</strong>: Salutations To The  a generous bestower of gold.</li><li><strong>Bhuutavetaalaghaatine (भूतवेतालघातिने)</strong>: Salutations To The one who is the great slayer of ghosts, demons, and vampires (vetalas).</li><li><strong>Vetaalaanucaraaya (वेतालानुचराय)</strong>: Salutations To The one who is followed and served by legions of vampires (vetalas).</li><li><strong>Ravaye (रवये)</strong>: Salutations To The one who roars, the radiant and powerful sun.</li><li><strong>Kaalaaya (कालाय)</strong>: Salutations To The one who is the embodiment of Time, the ultimate destroyer.</li><li><strong>Kaalaagnirudrashriye (कालाग्निरुद्रश्रियै)</strong>: Salutations To The one who possesses the glorious splendor of Rudra as the fire of time that ends the cosmos.</li><li><strong>Svarnaakarshanabhairavaaya (स्वर्णाकर्षणभैरवाय)</strong>: Salutations To The one who is the form of Bhairava that attracts and bestows gold.</li><li><strong>Kaalamaalaaya (कालमालय)</strong>: Salutations To The one who wears a garland of time or a garland of skulls representing time.</li><li><strong>Kalaamaalaaya (कलामालाय)</strong>: Salutations To The one who wears a garland of all the arts and cosmic divisions.</li><li><strong>Tryambakaaya (त्र्यम्बकाय)</strong>: Salutations To The one who possesses three eyes, the lord of the three worlds.</li><li><strong>Tripuraantakaaya (त्रिपुरांतकाय)</strong>: Salutations To The one who is the great destroyer of the three demonic cities (Tripura).</li><li><strong>Sarvaabhicaarahantre (सर्वाभिचारहन्त्रे)</strong>: Salutations To The one who is the ultimate destroyer of all black magic and malevolent spells.</li><li><strong>Parakrityanishuudanaaya (परकृत्यनिषूदनाय)</strong>: Salutations To The one who is the supreme vanquisher of evil magical rites performed by others.</li><li><strong>Mantramaaline (मंत्रमालिने)</strong>: Salutations To The one who wears a garland of sacred mantras.</li><li><strong>Sarpamaaline (सर्पमालिने)</strong>: Salutations To The one who wears a garland of live, divine serpents.</li><li><strong>Svarnaakarshana bhairavaaya (स्वर्णाकर्षण भैरवाय)</strong>: Salutations To The one who is the specific form of Bhairava that powerfully attracts gold and wealth.</li><li><strong>Shriidharaaya (श्रीधराय)</strong>: Salutations To The one who holds or possesses all glory, splendor, and prosperity (Shri).</li><li><strong>Shriikaraaya (श्रीकराय)</strong>: Salutations To The one who is the creator and bestower of all divine auspiciousness and wealth.</li><li><strong>Shriilaaya (श्रीलाय)</strong>: Salutations To The one who possesses a noble, virtuous, and excellent character.</li><li><strong>Shriinivaasaaya (श्रीनिवासाय)</strong>: Salutations To The one who is the sacred and eternal abode of all glory and prosperity (Shri).</li><li><strong>Sadaashivaaya (सदाशिवाय)</strong>: Salutations To The one who is eternally auspicious, benevolent, and the source of all good.</li><li><strong>Shriisvaruupaakritaye (श्रीस्वरूपकृतये)</strong>: Salutations To The one whose very form and nature is the embodiment of divine splendor.</li><li><strong>Shriimate (श्रीमते)</strong>: Salutations To The one who is glorious, resplendent, and endowed with all divine fortunes.</li><li><strong>Shriiharaaya (श्रीहाराय)</strong>: Salutations To The one who can take away prosperity from the undeserving, or who is the destroyer adorned with Shri.</li><li><strong>Shriimukhaaya (श्रीमूखाय)</strong>: Salutations To The one who has a glorious, auspicious, and beautiful face.</li><li><strong>Shivaaya (शिवाय)</strong>: Salutations To The one who is supremely auspicious, the ultimate reality.</li><li><strong>Shriishaantaaya (श्रीशान्ताय)</strong>: Salutations To The one who is the embodiment of glorious peace and tranquility.</li><li><strong>Shriivaraahaaya (श्रीवराहाय)</strong>: Salutations To The one who is the glorious and excellent boon-giver.</li><li><strong>Shriinivaasaaya (श्रीनिवासय)</strong>: Salutations To The one in whom all glory, wealth, and auspiciousness reside.</li><li><strong>Shriyaamvaraaya (श्रियाम् वराय)</strong>: Salutations To The one who is the best and most excellent of all glorious beings.</li><li><strong>Svarnadaaya (स्वर्णदाय)</strong>: Salutations To The one who is the generous giver of gold.</li><li><strong>Siddhidaaya (सिद्धिदाय)</strong>: Salutations To The one who is the bestower of all perfection and supernatural powers.</li><li><strong>Siddhaaya (सिद्धाय)</strong>: Salutations To The one who is the eternally perfected and accomplished being.</li><li><strong>Bhaktaanaam svarnadaayakaaya (भक्तानां स्वर्णदायकाय)</strong>: Salutations To The one who is the generous bestower of gold specifically to his devotees.</li></ul>
        </section>
    </noscript>
</body>
</html>