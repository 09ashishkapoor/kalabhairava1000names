            "numberOfItems": 1000,
            "itemListElement": [
                {"@type":"ListItem","position":1,"name":"Bhairavaaya","description":"Salutations To The one who is terrifying and destroys fear."},
                {"@type":"ListItem","position":2,"name":"Bhuutanaathaaya","description":"Salutations To The lord and master of all beings, including ghosts and spirits."},
                {"@type":"ListItem","position":3,"name":"Bhuutaatmane","description":"Salutations To The one who is the very soul and essence of all living beings."},
                {"@type":"ListItem","position":4,"name":"Bhuutabhaavanaaya","description":"Salutations To The creator and nurturer of all beings in the universe."},
                {"@type":"ListItem","position":5,"name":"Bhuutavaasaaya","description":"Salutations To The one who resides within all of existence and in whom all beings dwell."},
                {"@type":"ListItem","position":6,"name":"Bhuutaduutaaya","description":"Salutations To The one who has ghosts and spirits as his messengers."},
                {"@type":"ListItem","position":7,"name":"Bhuurishaaya","description":"Salutations To The one who possesses great wealth and abundance."},
                {"@type":"ListItem","position":8,"name":"Bhuuridakshinaaya","description":"Salutations To The one who is extremely generous and gives great rewards."},
                {"@type":"ListItem","position":9,"name":"Bhuutaadhyakshaaya","description":"Salutations To The supreme overseer and presides over all beings."},
                {"@type":"ListItem","position":10,"name":"Bhuutapataye","description":"Salutations To The commander and protector of all beings."},
                {"@type":"ListItem","position":11,"name":"Bhuudharaaya","description":"Salutations To The one who supports the Earth."},
                {"@type":"ListItem","position":12,"name":"Bhuudharaatmajaaya","description":"Salutations To The son of the mountain-bearer (often referring to Parvati's son, but here an epithet of Bhairava's power)."},
                {"@type":"ListItem","position":13,"name":"Bhuupataye","description":"Salutations To The supreme lord of the Earth."},
                {"@type":"ListItem","position":14,"name":"Bhaaskaraaya","description":"Salutations To The one who is radiant and effulgent like the sun."},
                {"@type":"ListItem","position":15,"name":"Bhiirave","description":"Salutations To The one who is formidable and inspires awe."},
                {"@type":"ListItem","position":16,"name":"Bhiimaaya","description":"Salutations To The one who is of immense and dreadful strength."},
                {"@type":"ListItem","position":17,"name":"Bhuumaye","description":"Salutations To The one who is the Earth itself."},
                {"@type":"ListItem","position":18,"name":"Vibhuutidaaya","description":"Salutations To The bestower of divine powers, prosperity, and sacred ash."},
                {"@type":"ListItem","position":19,"name":"Bhuutaaya","description":"Salutations To The one who has come into being and exists as all of creation."},
                {"@type":"ListItem","position":20,"name":"Bhuukampanaaya","description":"Salutations To The one who can cause the earth to tremble."}
            ]
        }
        </script>
    
